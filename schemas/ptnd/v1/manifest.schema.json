{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petunia.dev/schemas/ptnd/v1/manifest.schema.json",
  "title": "PTND Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "container_version",
    "schema_version",
    "minimum_reader_version",
    "writer",
    "document_id",
    "required_capabilities",
    "resources",
    "extensions",
    "previews"
  ],
  "properties": {
    "format": {
      "const": "petunia-design-document"
    },
    "container_version": {
      "const": 1
    },
    "schema_version": {
      "const": 1
    },
    "minimum_reader_version": {
      "type": "string",
      "minLength": 1
    },
    "writer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_version"],
      "properties": {
        "app_version": {
          "type": "string",
          "minLength": 1
        },
        "build_id": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "saved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "document_id": {
      "$ref": "#/$defs/uuid"
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource_entry"
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extension_entry"
      }
    },
    "previews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/preview_entry"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "entry_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "resource_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "entry",
        "media_type",
        "byte_size",
        "content_hash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "image",
            "font",
            "icc_profile",
            "pixel_surface",
            "pattern",
            "blob"
          ]
        },
        "entry": {
          "$ref": "#/$defs/entry_path"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "content_hash": {
          "$ref": "#/$defs/content_hash"
        }
      }
    },
    "extension_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "schema_version",
        "required"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "required": {
          "type": "boolean"
        },
        "entry": {
          "$ref": "#/$defs/entry_path"
        },
        "content_hash": {
          "$ref": "#/$defs/content_hash"
        }
      }
    },
    "preview_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "entry"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "thumbnail"
          ]
        },
        "entry": {
          "$ref": "#/$defs/entry_path"
        },
        "source_revision": {
          "type": "integer",
          "minimum": 0
        },
        "content_hash": {
          "$ref": "#/$defs/content_hash"
        }
      }
    }
  }
}
