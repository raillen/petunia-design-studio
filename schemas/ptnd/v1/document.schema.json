{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petunia.dev/schemas/ptnd/v1/document.schema.json",
  "title": "PTND document.json v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "document_id",
    "metadata",
    "setup",
    "pages",
    "spreads",
    "scene",
    "resources",
    "styles",
    "symbols",
    "swatches",
    "guides",
    "grids",
    "slices"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "document_id": {
      "$ref": "#/$defs/uuid"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "setup": {
      "$ref": "#/$defs/document_setup"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "spreads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/spread"
      }
    },
    "scene": {
      "$ref": "#/$defs/scene"
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource_record"
      }
    },
    "styles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/style_record"
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/symbol_definition"
      }
    },
    "swatches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/swatch"
      }
    },
    "guides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/guide"
      }
    },
    "grids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/grid"
      }
    },
    "slices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slice"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "finite_number": {
      "type": "number"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "$ref": "#/$defs/finite_number" },
        "y": { "$ref": "#/$defs/finite_number" }
      }
    },
    "vec2": {
      "$ref": "#/$defs/point"
    },
    "size2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "$ref": "#/$defs/point" },
        "max": { "$ref": "#/$defs/point" }
      }
    },
    "insets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": { "$ref": "#/$defs/finite_number" },
        "top": { "$ref": "#/$defs/finite_number" },
        "right": { "$ref": "#/$defs/finite_number" },
        "bottom": { "$ref": "#/$defs/finite_number" }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a", "b", "c", "d", "tx", "ty"],
      "properties": {
        "a": { "$ref": "#/$defs/finite_number" },
        "b": { "$ref": "#/$defs/finite_number" },
        "c": { "$ref": "#/$defs/finite_number" },
        "d": { "$ref": "#/$defs/finite_number" },
        "tx": { "$ref": "#/$defs/finite_number" },
        "ty": { "$ref": "#/$defs/finite_number" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "created": { "type": "string", "format": "date-time" },
        "modified": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" },
        "custom": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "color_space_ref": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "builtin" },
            "name": {
              "enum": ["srgb", "display-p3", "lab-d50", "gray"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "resource_id"],
          "properties": {
            "kind": { "const": "icc" },
            "resource_id": { "$ref": "#/$defs/uuid" }
          }
        }
      ]
    },
    "document_setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "default_raster_dpi", "color"],
      "properties": {
        "unit": {
          "enum": ["px", "pt", "mm", "cm", "inch", "pica"]
        },
        "default_raster_dpi": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "color": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rgb_working", "rendering_defaults"],
          "properties": {
            "rgb_working": { "$ref": "#/$defs/color_space_ref" },
            "cmyk_working": {
              "oneOf": [
                { "$ref": "#/$defs/color_space_ref" },
                { "type": "null" }
              ]
            },
            "gray_working": {
              "oneOf": [
                { "$ref": "#/$defs/color_space_ref" },
                { "type": "null" }
              ]
            },
            "rendering_defaults": {
              "type": "object",
              "additionalProperties": false,
              "required": ["intent", "black_point_compensation"],
              "properties": {
                "intent": {
                  "enum": ["relative_colorimetric", "absolute_colorimetric", "perceptual", "saturation"]
                },
                "black_point_compensation": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "page_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "margins", "bleed"],
      "properties": {
        "size": { "$ref": "#/$defs/size2" },
        "margins": { "$ref": "#/$defs/insets" },
        "bleed": { "$ref": "#/$defs/insets" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "spec", "root_children"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string" },
        "spec": { "$ref": "#/$defs/page_spec" },
        "root_children": {
          "type": "array",
          "items": { "$ref": "#/$defs/uuid" }
        }
      }
    },
    "spread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pages"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page", "origin"],
            "properties": {
              "page": { "$ref": "#/$defs/uuid" },
              "origin": { "$ref": "#/$defs/point" }
            }
          }
        }
      }
    },
    "parent_ref": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "page" },
            "id": { "$ref": "#/$defs/uuid" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "object" },
            "id": { "$ref": "#/$defs/uuid" }
          }
        }
      ]
    },
    "node_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible", "locked", "exportable"],
      "properties": {
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "exportable": { "type": "boolean" }
      }
    },
    "blend_mode": {
      "enum": [
        "normal",
        "multiply",
        "screen",
        "overlay",
        "darken",
        "lighten",
        "color_dodge",
        "color_burn",
        "hard_light",
        "soft_light",
        "difference",
        "exclusion",
        "hue",
        "saturation",
        "color",
        "luminosity"
      ]
    },
    "binding_source_use": {
      "enum": ["binding_only", "also_visible"]
    },
    "clip_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "source_use"],
      "properties": {
        "source": { "$ref": "#/$defs/uuid" },
        "source_use": { "$ref": "#/$defs/binding_source_use" }
      }
    },
    "mask_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "source_use", "mode"],
      "properties": {
        "source": { "$ref": "#/$defs/uuid" },
        "source_use": { "$ref": "#/$defs/binding_source_use" },
        "mode": { "enum": ["alpha", "luminance"] }
      }
    },
    "effect_instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "enabled", "opacity", "blend_mode", "kind", "schema_version", "params"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "enabled": { "type": "boolean" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "blend_mode": { "$ref": "#/$defs/blend_mode" },
        "kind": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "integer", "minimum": 1 },
        "params": { "type": "object", "additionalProperties": true }
      }
    },
    "path_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position", "kind", "outgoing"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "position": { "$ref": "#/$defs/point" },
        "handle_in": {
          "oneOf": [
            { "$ref": "#/$defs/point" },
            { "type": "null" }
          ]
        },
        "handle_out": {
          "oneOf": [
            { "$ref": "#/$defs/point" },
            { "type": "null" }
          ]
        },
        "kind": { "enum": ["cusp", "smooth", "symmetric"] },
        "outgoing": { "enum": ["line", "cubic"] }
      }
    },
    "contour": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nodes", "closed"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/path_node" }
        },
        "closed": { "type": "boolean" }
      }
    },
    "vector_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fill_rule", "contours"],
      "properties": {
        "fill_rule": { "enum": ["nonzero", "evenodd"] },
        "contours": {
          "type": "array",
          "items": { "$ref": "#/$defs/contour" }
        }
      }
    },
    "parametric_shape": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "size", "corners"],
          "properties": {
            "kind": { "const": "rectangle" },
            "size": { "$ref": "#/$defs/size2" },
            "corners": { "type": "object", "additionalProperties": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "radii", "arc"],
          "properties": {
            "kind": { "const": "ellipse" },
            "radii": { "$ref": "#/$defs/vec2" },
            "arc": { "type": "object", "additionalProperties": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sides", "radius", "rotation"],
          "properties": {
            "kind": { "const": "polygon" },
            "sides": { "type": "integer", "minimum": 3 },
            "radius": { "type": "number", "minimum": 0 },
            "rotation": { "$ref": "#/$defs/finite_number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "points", "outer_radius", "inner_ratio", "rotation"],
          "properties": {
            "kind": { "const": "star" },
            "points": { "type": "integer", "minimum": 2 },
            "outer_radius": { "type": "number", "minimum": 0 },
            "inner_ratio": { "type": "number", "minimum": 0 },
            "rotation": { "$ref": "#/$defs/finite_number" }
          }
        }
      ]
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "enabled", "opacity", "blend_mode", "kind", "payload"],
            "properties": {
              "id": { "$ref": "#/$defs/uuid" },
              "enabled": { "type": "boolean" },
              "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
              "blend_mode": { "$ref": "#/$defs/blend_mode" },
              "kind": { "enum": ["fill", "stroke"] },
              "payload": { "type": "object", "additionalProperties": true }
            }
          }
        }
      }
    },
    "appearance_source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "appearance"],
          "properties": {
            "kind": { "const": "local" },
            "appearance": { "$ref": "#/$defs/appearance" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "style_id"],
          "properties": {
            "kind": { "const": "style" },
            "style_id": { "$ref": "#/$defs/uuid" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "style_id", "overrides"],
          "properties": {
            "kind": { "const": "style_with_overrides" },
            "style_id": { "$ref": "#/$defs/uuid" },
            "overrides": { "type": "object", "additionalProperties": true }
          }
        }
      ]
    },
    "text_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "text_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "runs", "paragraphs", "container", "flow"],
      "properties": {
        "text": { "type": "string" },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["range", "style"],
            "properties": {
              "range": { "$ref": "#/$defs/text_range" },
              "style": { "$ref": "#/$defs/uuid" }
            }
          }
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["range", "style"],
            "properties": {
              "range": { "$ref": "#/$defs/text_range" },
              "style": { "$ref": "#/$defs/uuid" }
            }
          }
        },
        "container": { "type": "object", "additionalProperties": true },
        "flow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["next"],
          "properties": {
            "next": {
              "oneOf": [
                { "$ref": "#/$defs/uuid" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "trace_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "alpha_policy",
        "threshold",
        "min_region_area_px",
        "corner_sensitivity",
        "smoothing",
        "curve_tolerance"
      ],
      "properties": {
        "mode": { "type": "object", "additionalProperties": true },
        "alpha_policy": { "type": "object", "additionalProperties": true },
        "threshold": { "type": "number" },
        "min_region_area_px": { "type": "number", "minimum": 0 },
        "corner_sensitivity": { "type": "number" },
        "smoothing": { "type": "number" },
        "curve_tolerance": { "type": "number", "exclusiveMinimum": 0 },
        "ignore_background": { "type": ["object", "null"], "additionalProperties": true }
      }
    },
    "generator_spec": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "spec"],
          "properties": {
            "kind": { "const": "qr_code" },
            "spec": { "type": "object", "additionalProperties": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "spec"],
          "properties": {
            "kind": { "const": "barcode" },
            "spec": { "type": "object", "additionalProperties": true }
          }
        }
      ]
    },
    "scene_item": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "children"],
          "properties": {
            "type": { "const": "group" },
            "children": { "type": "array", "items": { "$ref": "#/$defs/uuid" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "children"],
          "properties": {
            "type": { "const": "layer" },
            "children": { "type": "array", "items": { "$ref": "#/$defs/uuid" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "appearance"],
          "properties": {
            "type": { "const": "path" },
            "path": { "$ref": "#/$defs/vector_path" },
            "appearance": { "$ref": "#/$defs/appearance_source" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "shape", "appearance"],
          "properties": {
            "type": { "const": "shape" },
            "shape": { "$ref": "#/$defs/parametric_shape" },
            "appearance": { "$ref": "#/$defs/appearance_source" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "text" },
            "text": { "$ref": "#/$defs/text_object" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "resource", "sampling"],
          "properties": {
            "type": { "const": "image" },
            "resource": { "$ref": "#/$defs/uuid" },
            "source_rect": {
              "oneOf": [
                { "$ref": "#/$defs/rect" },
                { "type": "null" }
              ]
            },
            "sampling": { "enum": ["nearest", "bilinear"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "surface"],
          "properties": {
            "type": { "const": "pixel_layer" },
            "surface": { "$ref": "#/$defs/uuid" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "source", "spec"],
          "properties": {
            "type": { "const": "trace" },
            "source": { "$ref": "#/$defs/uuid" },
            "spec": { "$ref": "#/$defs/trace_spec" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "generator", "appearance"],
          "properties": {
            "type": { "const": "generated_vector" },
            "generator": { "$ref": "#/$defs/generator_spec" },
            "appearance": { "$ref": "#/$defs/appearance_source" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "spec", "children"],
          "properties": {
            "type": { "const": "artboard" },
            "spec": { "type": "object", "additionalProperties": true },
            "children": { "type": "array", "items": { "$ref": "#/$defs/uuid" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "definition", "overrides"],
          "properties": {
            "type": { "const": "symbol_instance" },
            "definition": { "$ref": "#/$defs/uuid" },
            "overrides": { "type": "object", "additionalProperties": true }
          }
        }
      ]
    },
    "scene_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "parent",
        "transform",
        "flags",
        "opacity",
        "blend_mode",
        "geometry_effects",
        "post_effects",
        "clip",
        "mask",
        "item"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string" },
        "parent": { "$ref": "#/$defs/parent_ref" },
        "transform": { "$ref": "#/$defs/transform" },
        "flags": { "$ref": "#/$defs/node_flags" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "blend_mode": { "$ref": "#/$defs/blend_mode" },
        "geometry_effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/effect_instance" }
        },
        "post_effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/effect_instance" }
        },
        "clip": {
          "oneOf": [
            { "$ref": "#/$defs/clip_binding" },
            { "type": "null" }
          ]
        },
        "mask": {
          "oneOf": [
            { "$ref": "#/$defs/mask_binding" },
            { "type": "null" }
          ]
        },
        "item": { "$ref": "#/$defs/scene_item" }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/scene_node" }
        }
      }
    },
    "resource_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source", "metadata"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "kind": {
          "enum": ["image", "font", "icc_profile", "pixel_surface", "pattern", "blob"]
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "entry"],
              "properties": {
                "kind": { "const": "embedded" },
                "entry": { "type": "string", "minLength": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "uri"],
              "properties": {
                "kind": { "const": "linked" },
                "uri": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "content_hash": {
          "type": ["string", "null"],
          "pattern": "^blake3:[0-9a-f]{64}$"
        },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },
    "style_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "payload"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string" },
        "kind": { "enum": ["appearance", "character", "paragraph"] },
        "payload": { "type": "object", "additionalProperties": true }
      }
    },
    "symbol_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "root_children", "nodes"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string" },
        "root_children": {
          "type": "array",
          "items": { "$ref": "#/$defs/uuid" }
        },
        "nodes": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "swatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string" },
        "value": { "type": "object", "additionalProperties": true }
      }
    },
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "axis", "position", "locked", "scope"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "axis": { "enum": ["horizontal", "vertical"] },
        "position": { "$ref": "#/$defs/finite_number" },
        "locked": { "type": "boolean" },
        "scope": { "type": "object", "additionalProperties": true }
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "origin", "kind", "spacing", "subdivisions"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "scope": { "type": "object", "additionalProperties": true },
        "origin": { "$ref": "#/$defs/point" },
        "kind": { "type": "string", "minLength": 1 },
        "spacing": { "$ref": "#/$defs/vec2" },
        "subdivisions": { "type": "integer", "minimum": 1 }
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "name", "export_presets"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "source": { "type": "object", "additionalProperties": true },
        "name": { "type": "string" },
        "export_presets": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        }
      }
    }
  }
}
