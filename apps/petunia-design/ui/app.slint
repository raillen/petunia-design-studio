import { Button, CheckBox, LineEdit, Slider, ScrollView } from "std-widgets.slint";
import { IconDisplay, IconSet, Icon } from "@lucide";
import { Badge, BadgeVariant } from "slintcn/components/badge.slint";
import { Tokens } from "tokens.slint";

export struct LayerRowItem {
    name: string,
    visible: bool,
    locked: bool,
    selected: bool,
    kind: string,
    depth: length,
    is_container: bool,
    is_clip_mask: bool,
    is_clipped: bool,
}

export struct PaletteItem {
    id: string,
    label: string,
    hint: string,
}

export struct HistoryRowItem {
    index: int,
    description: string,
}

export struct AppearanceFillItem {
    id: int,
    paint_type: string,
    color_label: string,
    opacity_pct: int,
    visible: bool,
}

export struct AppearanceStrokeItem {
    id: int,
    paint_type: string,
    color_label: string,
    width_pt: float,
    opacity_pct: int,
    visible: bool,
}

export struct CanvasObjectItem {
    id: string,
    name: string,
    x: length,
    y: length,
    w: length,
    h: length,
    bg_color: color,
    stroke_color: color,
    stroke_width: length,
    corner_radius: length,
    selected: bool,
    is_circle: bool,
    is_path: bool,
    is_text: bool,
    text_content: string,
    text_size: float,
    text_color: color,
    svg_path: string,
    opacity: float,
}

component StudioIconButton inherits Rectangle {
    in property <Icon> icon;
    in property <bool> active: false;
    in property <string> tooltip: "";
    callback clicked;

    width: 32px;
    height: 32px;
    border-radius: 4px;
    background: active ? Tokens.accent-selection-soft : (touch.has-hover ? Tokens.overlay-hover : transparent);
    border-width: active ? 1px : 0px;
    border-color: Tokens.accent-bloom;

    IconDisplay {
        icon: root.icon;
        size: 16px;
        stroke: root.active ? Tokens.accent-bloom-hover : (touch.has-hover ? Tokens.text-primary : Tokens.text-tertiary);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component StudioToolButton inherits Rectangle {
    in property <Icon> icon;
    in property <bool> active: false;
    in property <string> shortcut: "";
    callback clicked;

    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: active ? Tokens.accent-faint : (touch.has-hover ? Tokens.overlay-hover : transparent);
    border-width: active ? 1px : 0px;
    border-color: Tokens.accent-bloom;

    IconDisplay {
        icon: root.icon;
        size: 18px;
        stroke: root.active ? Tokens.accent-bloom-hover : (touch.has-hover ? Tokens.text-primary : Tokens.text-tertiary);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component StudioMenuButton inherits Rectangle {
    in property <string> label;
    callback clicked;

    height: 24px;
    border-radius: 4px;
    background: touch.has-hover ? Tokens.overlay-hover : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        Text {
            text: root.label;
            font-size: 12px;
            color: touch.has-hover ? Tokens.text-primary : Tokens.text-secondary;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component StudioPersonaTab inherits Rectangle {
    in property <string> label;
    in property <Icon> icon;
    in property <bool> active: false;
    callback clicked;

    height: 24px;
    border-radius: 4px;
    background: active ? Tokens.accent-bloom : (touch.has-hover ? Tokens.overlay-hover : transparent);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 5px;
        alignment: center;

        IconDisplay {
            icon: root.icon;
            size: 13px;
            stroke: root.active ? Tokens.text-primary : (touch.has-hover ? Tokens.text-primary : Tokens.text-tertiary);
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.label;
            font-size: 11px;
            font-weight: root.active ? 600 : 500;
            color: root.active ? Tokens.text-primary : Tokens.text-tertiary;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component StudioTabItem inherits Rectangle {
    in property <string> title;
    in property <bool> is_dirty: true;
    in property <bool> active: true;
    callback clicked;
    callback close_clicked;

    height: 30px;
    border-radius: 4px;
    background: active ? Tokens.surface-panel : Tokens.surface-workspace;
    border-width: active ? 1px : 0px;
    border-color: Tokens.border-subtle;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;

        IconDisplay {
            icon: IconSet.FileCode;
            size: 13px;
            stroke: root.active ? Tokens.accent-bloom-hover : Tokens.text-disabled;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.title + (root.is_dirty ? " •" : "");
            font-size: 12px;
            color: root.active ? Tokens.text-primary : Tokens.text-secondary;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }

        Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 3px;
            background: close_touch.has-hover ? Tokens.status-error : transparent;

            IconDisplay {
                icon: IconSet.X;
                size: 10px;
                stroke: close_touch.has-hover ? Tokens.status-error : Tokens.text-disabled;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            close_touch := TouchArea {
                clicked => { root.close_clicked(); }
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "Petunia Design Studio";
    preferred-width: 1440px;
    preferred-height: 900px;
    background: Tokens.surface-workspace;

    forward-focus: root_fs;
    root_fs := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            // Arrow Keys Nudge
            if (event.text == Key.UpArrow) {
                root.nudge_selected(0.0, event.modifiers.shift ? -10.0 : (event.modifiers.alt ? -0.1 : -1.0));
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.nudge_selected(0.0, event.modifiers.shift ? 10.0 : (event.modifiers.alt ? 0.1 : 1.0));
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.nudge_selected(event.modifiers.shift ? -10.0 : (event.modifiers.alt ? -0.1 : -1.0), 0.0);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.nudge_selected(event.modifiers.shift ? 10.0 : (event.modifiers.alt ? 0.1 : 1.0), 0.0);
                return accept;
            }

            // Delete / Backspace
            if (event.text == Key.Delete || event.text == Key.Backspace) {
                root.delete_selected_clicked();
                return accept;
            }

            // Escape closes the command palette first
            if (event.text == Key.Escape && root.palette_open) {
                root.close_palette();
                return accept;
            }

            // Tab / Shift+Tab Cycling
            if (event.text == Key.Tab) {
                root.cycle_selection_clicked(!event.modifiers.shift);
                return accept;
            }

            // Ctrl / Meta Shortcuts
            if (event.modifiers.control || event.modifiers.meta) {
                // Command palette: Ctrl+K
                if (event.text == "k" || event.text == "K") {
                    root.open_palette();
                    return accept;
                }
                // Select All: Ctrl+A
                if (event.text == "a" || event.text == "A") {
                    root.select_all_clicked();
                    return accept;
                }
                // Duplicate: Ctrl+D
                if (event.text == "d" || event.text == "D") {
                    root.duplicate_selected_clicked();
                    return accept;
                }
                // Group: Ctrl+G / Ungroup: Ctrl+Shift+G
                if (event.text == "g" || event.text == "G") {
                    if (event.modifiers.shift) {
                        root.ungroup_selected_clicked();
                    } else {
                        root.group_selected_clicked();
                    }
                    return accept;
                }
                // Undo: Ctrl+Z / Redo: Ctrl+Shift+Z or Ctrl+Y
                if (event.text == "z" || event.text == "Z") {
                    if (event.modifiers.shift) {
                        root.redo_clicked();
                    } else {
                        root.undo_clicked();
                    }
                    return accept;
                }
                if (event.text == "y" || event.text == "Y") {
                    root.redo_clicked();
                    return accept;
                }
                // Export Dialog: Ctrl+E
                if (event.text == "e" || event.text == "E") {
                    root.open_export_dialog_clicked();
                    return accept;
                }
            }

            return reject;
        }
    }

    // View state
    in-out property <string> active_tool_name: "Select";
    in-out property <int> active_persona: 0; // 0: Design, 1: Photo
    in-out property <string> document_title: "Showcase Project.aub";
    in-out property <int> zoom_pct: 100;
    in-out property <bool> snap_enabled: true;
    // Select marquee rule backing the settings option (Batch 1):
    // "Directional" (auto por direção) | "Intersect" (ao sobrepor) | "Contained" (objeto inteiro).
    in-out property <string> marquee_rule: "Directional";
    in-out property <string> status_coords: "Doc: X: 120.0 pt  Y: 180.0 pt";
    in-out property <string> status_hint: "Select: Clique para selecionar, arraste para mover | Shift: Multi-seleção | Alt: Duplicar";
    in-out property <int> active_tab_index: 0; // 0: Camadas, 1: Propriedades, 2: Histórico, 3: Dados

    // Inspector Properties
    in-out property <bool> has_selection: true;
    in-out property <string> selected_name: "Hero Card";
    in-out property <string> selected_bounds: "X: 100.0 pt  Y: 100.0 pt  W: 300.0 pt  H: 180.0 pt";
    in-out property <string> selected_fill: "ptnd.blue/500";
    in-out property <string> selected_stroke: "Tokens.accent-bloom-pressed (1.5 pt)";
    in-out property <float> selected_opacity: 100.0;
    in-out property <length> prop_x: 100px;
    in-out property <length> prop_y: 100px;
    in-out property <length> prop_w: 300px;
    in-out property <length> prop_h: 180px;
    in-out property <float> prop_rot: 0.0;
    in-out property <float> prop_stroke_width: 1.0;

    // Data merge
    in-out property <string> merge_source: "showcase_data.csv";
    in-out property <int> merge_records: 120;
    in-out property <int> merge_bindings: 4;

    in-out property <[LayerRowItem]> layer_rows: [
        { name: "Hero Card", visible: true, locked: false, selected: true, kind: "Rectangle", depth: 0px, is_container: false, is_clip_mask: false, is_clipped: false },
        { name: "Accent Circle", visible: true, locked: false, selected: false, kind: "Ellipse", depth: 0px, is_container: false, is_clip_mask: false, is_clipped: false },
        { name: "Vector Headline", visible: true, locked: false, selected: false, kind: "Text", depth: 0px, is_container: false, is_clip_mask: false, is_clipped: false },
    ];
    in-out property <[HistoryRowItem]> history_rows: [
        { index: 1, description: "Criar Prancheta Principal" },
        { index: 2, description: "Criar Hero Card" },
        { index: 3, description: "Criar Accent Circle" },
        { index: 4, description: "Criar Vector Headline" },
    ];

    // Canvas geometry
    in-out property <length> artboard_x: 80px;
    in-out property <length> artboard_y: 80px;
    in-out property <length> artboard_w: 800px;
    in-out property <length> artboard_h: 600px;
    in-out property <length> bleed_margin: 10px;
    in-out property <length> margin_inset: 36px;
    in-out property <length> guide_x: 200px;

    // Interactive Drag Preview
    in-out property <bool> has_preview: false;
    in-out property <length> preview_x: 0px;
    in-out property <length> preview_y: 0px;
    in-out property <length> preview_w: 0px;
    in-out property <length> preview_h: 0px;

    // Canvas cursor state
    in-out property <string> canvas_cursor_kind: "default";

    // Dynamic Objects
    in-out property <[CanvasObjectItem]> canvas_objects: [
        { id: "1", name: "Hero Card", x: 100px, y: 100px, w: 300px, h: 180px, bg_color: Tokens.accent-bloom, stroke_color: Tokens.accent-bloom-pressed, stroke_width: 1.5px, corner_radius: 8px, selected: true, is_circle: false, is_path: false, is_text: false, text_content: "", text_size: 16.0, text_color: #18181b, svg_path: "", opacity: 1.0 },
        { id: "2", name: "Accent Circle", x: 450px, y: 140px, w: 140px, h: 140px, bg_color: #eab308, stroke_color: #ca8a04, stroke_width: 1.5px, corner_radius: 0px, selected: false, is_circle: true, is_path: false, is_text: false, text_content: "", text_size: 16.0, text_color: #18181b, svg_path: "", opacity: 1.0 },
        { id: "3", name: "Vector Headline", x: 100px, y: 320px, w: 300px, h: 50px, bg_color: #a855f7, stroke_color: transparent, stroke_width: 0px, corner_radius: 0px, selected: false, is_circle: false, is_path: false, is_text: true, text_content: "Petunia Design Studio", text_size: 20.0, text_color: #18181b, svg_path: "", opacity: 1.0 },
    ];

    // Appearance Properties (10.4)
    in-out property <string> prop_blend_mode: "Normal";
    in-out property <[AppearanceFillItem]> prop_fills: [];
    in-out property <[AppearanceStrokeItem]> prop_strokes: [];

    // Callbacks
    callback select_tool(string);
    callback switch_persona(int);
    callback undo_clicked();
    callback redo_clicked();
    callback zoom_in_clicked();
    callback zoom_out_clicked();
    callback fit_canvas_clicked();
    callback new_doc_clicked();
    callback open_doc_clicked();
    callback save_doc_clicked();
    callback place_image_clicked();
    callback snap_toggled(bool);
    callback marquee_rule_changed(string);
    callback tab_changed(int);
    callback canvas_dragged(length, length);
    callback canvas_pointer_down(length, length);
    callback canvas_pointer_up(length, length);
    callback select_layer_by_index(int);
    callback delete_selected_clicked();
    callback duplicate_selected_clicked();
    callback add_rectangle_clicked();
    callback add_circle_clicked();
    callback add_star_clicked();
    callback add_text_clicked();
    callback boolean_union_clicked();
    callback boolean_subtract_clicked();
    callback boolean_intersect_clicked();
    callback boolean_xor_clicked();
    callback convert_to_curves_clicked();
    callback bake_corners_clicked();
    callback bake_contour_clicked();
    callback align_objects_clicked(string);
    callback distribute_objects_clicked(string);
    callback set_selected_color(color);
    callback commit_prop_x(string);
    callback commit_prop_y(string);
    callback commit_prop_w(string);
    callback commit_prop_h(string);
    callback commit_prop_rot(string);
    callback set_stroke_width_value(float);
    callback set_opacity_value(float);
    callback toggle_layer_visibility(int);
    callback toggle_layer_lock(int);
    callback reorder_layer_up(int);
    callback reorder_layer_down(int);
    callback set_blend_mode_clicked(string);
    callback add_fill_clicked();
    callback remove_fill_clicked(int);
    callback add_stroke_clicked();
    callback remove_stroke_clicked(int);
    callback set_gradient_clicked(string);

    // Hierarchy & Grouping Callbacks (10.5)
    callback group_selected_clicked();
    callback ungroup_selected_clicked();
    callback create_clip_mask_clicked();
    callback release_clip_mask_clicked();

    // Shortcuts & Selection Navigation
    callback nudge_selected(float, float);
    callback select_all_clicked();
    callback cycle_selection_clicked(bool);

    // Export Flow Callbacks & Properties
    in-out property <bool> export_dialog_open: false;
    // Command Palette (Ctrl+K) — semantic entry point (08.2)
    in-out property <bool> palette_open: false;
    in-out property <string> palette_query: "";
    in-out property <[PaletteItem]> palette_items: [];
    callback open_palette();
    callback close_palette();
    callback palette_query_changed(string);
    callback palette_activate(string);
    callback palette_activate_first();
    in-out property <string> export_format: "png";
    in-out property <string> export_status_message: "";
    callback open_export_dialog_clicked();
    callback close_export_dialog_clicked();
    callback set_export_format(string);
    callback do_export_clicked();

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // -------------------------------------------------------------
        // SECTION 1: STUDIO MENU BAR & PERSONA SWITCHER (08.2)
        // -------------------------------------------------------------
        Rectangle {
            height: 32px;
            background: Tokens.surface-chrome;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 10px;
                spacing: 4px;

                // Brand Badge
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    padding-right: 8px;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 4px;
                        background: Tokens.accent-bloom;
                        Text {
                            text: "A";
                            color: Tokens.text-primary;
                            font-size: 11px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: "Petunia Design Studio";
                        color: Tokens.text-primary;
                        font-weight: 700;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                // Studio Menus
                StudioMenuButton { label: "Arquivo"; clicked => { root.new_doc_clicked(); } }
                StudioMenuButton { label: "Exportar"; clicked => { root.open_export_dialog_clicked(); } }
                StudioMenuButton { label: "Editar"; clicked => { root.duplicate_selected_clicked(); } }
                StudioMenuButton { label: "Camada"; clicked => { root.convert_to_curves_clicked(); } }
                StudioMenuButton { label: "Selecionar"; clicked => { root.tab_changed(0); } }
                StudioMenuButton { label: "Documento"; clicked => { root.fit_canvas_clicked(); } }
                StudioMenuButton { label: "Exibir"; clicked => { root.zoom_in_clicked(); } }

                // Spacer
                Rectangle { horizontal-stretch: 1; }

                // Persona Switcher (Design vs Photo) (08.2)
                Rectangle {
                    height: 26px;
                    border-radius: 5px;
                    background: Tokens.surface-chrome-strong;
                    border-width: 1px;
                    border-color: Tokens.border-subtle;

                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;
                        StudioPersonaTab {
                            label: "Design Persona";
                            icon: IconSet.PenTool;
                            active: root.active_persona == 0;
                            clicked => { root.active_persona = 0; root.switch_persona(0); }
                        }
                        StudioPersonaTab {
                            label: "Photo Persona";
                            icon: IconSet.Crop;
                            active: root.active_persona == 1;
                            clicked => { root.active_persona = 1; root.switch_persona(1); }
                        }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Tokens.border-subtle; }

        // -------------------------------------------------------------
        // SECTION 2: DOCUMENT TAB STRIP (08.2)
        // -------------------------------------------------------------
        Rectangle {
            height: 32px;
            background: Tokens.surface-chrome-strong;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 12px;
                spacing: 4px;

                // Document Tab
                StudioTabItem {
                    title: root.document_title;
                    is_dirty: true;
                    active: true;
                    clicked => {}
                    close_clicked => {}
                }

                // New tab button
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: touch_new_tab.has-hover ? Tokens.overlay-hover : transparent;
                    y: (parent.height - self.height) / 2;

                    IconDisplay {
                        icon: IconSet.Plus;
                        size: 12px;
                        stroke: Tokens.text-tertiary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    touch_new_tab := TouchArea {
                        clicked => { root.new_doc_clicked(); }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                // Quick Viewport & Snapping controls
                HorizontalLayout {
                    spacing: 4px;
                    alignment: center;

                    StudioIconButton {
                        icon: IconSet.Undo2;
                        tooltip: "Desfazer (Ctrl+Z)";
                        clicked => { root.undo_clicked(); }
                    }
                    StudioIconButton {
                        icon: IconSet.Redo2;
                        tooltip: "Refazer (Ctrl+Y)";
                        clicked => { root.redo_clicked(); }
                    }

                    Rectangle { width: 1px; height: 16px; background: Tokens.border-subtle; y: 8px; }

                    StudioIconButton {
                        icon: IconSet.Minus;
                        tooltip: "Reduzir Zoom";
                        clicked => { root.zoom_out_clicked(); }
                    }

                    Rectangle {
                        height: 24px;
                        border-radius: 4px;
                        background: Tokens.surface-panel;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: root.zoom_pct + "%";
                                font-size: 11px;
                                color: Tokens.text-secondary;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    StudioIconButton {
                        icon: IconSet.Plus;
                        tooltip: "Aumentar Zoom";
                        clicked => { root.zoom_in_clicked(); }
                    }
                    StudioIconButton {
                        icon: IconSet.Maximize2;
                        tooltip: "Ajustar à Tela";
                        clicked => { root.fit_canvas_clicked(); }
                    }

                    Rectangle { width: 1px; height: 16px; background: Tokens.border-subtle; y: 8px; }

                    // Snap toggle
                    Rectangle {
                        height: 24px;
                        border-radius: 4px;
                        background: root.snap_enabled ? Tokens.accent-faint : Tokens.surface-panel;
                        border-width: root.snap_enabled ? 1px : 0px;
                        border-color: Tokens.accent-bloom;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            alignment: center;

                            IconDisplay {
                                icon: IconSet.Lock;
                                size: 11px;
                                stroke: root.snap_enabled ? Tokens.accent-bloom-hover : Tokens.text-disabled;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: "Snap";
                                font-size: 11px;
                                font-weight: 500;
                                color: root.snap_enabled ? Tokens.accent-bloom-hover : Tokens.text-tertiary;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => {
                                root.snap_enabled = !root.snap_enabled;
                                root.snap_toggled(root.snap_enabled);
                            }
                        }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Tokens.border-subtle; }

        // -------------------------------------------------------------
        // SECTION 3: CANONICAL CONTEXT TOOLBAR (08.23)
        // -------------------------------------------------------------
        Rectangle {
            height: 38px;
            background: Tokens.surface-panel;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                alignment: center;

                // Active tool indicator badge
                Rectangle {
                    height: 24px;
                    border-radius: 4px;
                    background: Tokens.surface-control;
                    border-width: 1px;
                    border-color: Tokens.border-strong;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        alignment: center;

                        IconDisplay {
                            icon: root.active_tool_name == "Node" ? IconSet.Pointer :
                                  root.active_tool_name == "Pen" ? IconSet.PenTool :
                                  root.active_tool_name == "Pencil" ? IconSet.Pencil :
                                  root.active_tool_name == "Rectangle" ? IconSet.Square :
                                  root.active_tool_name == "Ellipse" ? IconSet.Circle :
                                  root.active_tool_name == "Star" ? IconSet.Star :
                                  root.active_tool_name == "Text" ? IconSet.Type :
                                  root.active_tool_name == "Scissors" ? IconSet.Scissors :
                                  root.active_tool_name == "Zoom" ? IconSet.ZoomIn : IconSet.MousePointer2;
                            size: 13px;
                            stroke: Tokens.accent-bloom-hover;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: root.active_tool_name;
                            font-size: 11px;
                            font-weight: 700;
                            color: Tokens.text-primary;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { width: 1px; height: 18px; background: Tokens.border-subtle; y: 10px; }

                // Select marquee rule (Batch 1 — settings option, contextual):
                // Auto = direcional | Sobrepor = intersect | Completa = contained.
                HorizontalLayout {
                    spacing: 2px;
                    alignment: center;

                    Text { text: "Seleção:"; font-size: 11px; color: Tokens.text-disabled; vertical-alignment: center; }

                    Rectangle {
                        height: 22px;
                        border-radius: 4px;
                        background: root.marquee_rule == "Intersect" ? Tokens.accent-faint : transparent;
                        border-width: 1px;
                        border-color: root.marquee_rule == "Intersect" ? Tokens.accent-bloom-hover : transparent;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: center;
                            Text { text: "Sobrepor"; font-size: 11px; color: root.marquee_rule == "Intersect" ? Tokens.accent-bloom-hover : Tokens.text-tertiary; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { root.marquee_rule = "Intersect"; root.marquee_rule_changed("Intersect"); } }
                    }

                    Rectangle {
                        height: 22px;
                        border-radius: 4px;
                        background: root.marquee_rule == "Contained" ? Tokens.accent-faint : transparent;
                        border-width: 1px;
                        border-color: root.marquee_rule == "Contained" ? Tokens.accent-bloom-hover : transparent;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: center;
                            Text { text: "Completa"; font-size: 11px; color: root.marquee_rule == "Contained" ? Tokens.accent-bloom-hover : Tokens.text-tertiary; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { root.marquee_rule = "Contained"; root.marquee_rule_changed("Contained"); } }
                    }

                    Rectangle {
                        height: 22px;
                        border-radius: 4px;
                        background: root.marquee_rule == "Directional" ? Tokens.accent-faint : transparent;
                        border-width: 1px;
                        border-color: root.marquee_rule == "Directional" ? Tokens.accent-bloom-hover : transparent;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: center;
                            Text { text: "Auto"; font-size: 11px; color: root.marquee_rule == "Directional" ? Tokens.accent-bloom-hover : Tokens.text-tertiary; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { root.marquee_rule = "Directional"; root.marquee_rule_changed("Directional"); } }
                    }
                }

                Rectangle { width: 1px; height: 18px; background: Tokens.border-subtle; y: 10px; }

                // Selection Transform HUD Numeric Readout (08.23, 10.1)
                if root.has_selection : HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    Text { text: "X: " + Math.round(root.prop_x / 1px) + " pt"; font-size: 11px; color: Tokens.text-tertiary; vertical-alignment: center; }
                    Text { text: "Y: " + Math.round(root.prop_y / 1px) + " pt"; font-size: 11px; color: Tokens.text-tertiary; vertical-alignment: center; }
                    Text { text: "W: " + Math.round(root.prop_w / 1px) + " pt"; font-size: 11px; color: Tokens.text-tertiary; vertical-alignment: center; }
                    Text { text: "H: " + Math.round(root.prop_h / 1px) + " pt"; font-size: 11px; color: Tokens.text-tertiary; vertical-alignment: center; }
                    Text { text: "R: " + Math.round(root.prop_rot) + "°"; font-size: 11px; color: Tokens.text-tertiary; vertical-alignment: center; }
                }

                Rectangle { width: 1px; height: 18px; background: Tokens.border-subtle; y: 10px; }

                // Quick Fill & Stroke Swatches
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    Text { text: "Fill:"; font-size: 11px; color: Tokens.text-disabled; vertical-alignment: center; }
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 3px;
                        background: Tokens.accent-bloom;
                        border-width: 1px;
                        border-color: Tokens.accent-bloom-hover;
                        TouchArea { clicked => { root.set_selected_color(Tokens.accent-bloom); } }
                    }

                    Text { text: "Stroke:"; font-size: 11px; color: Tokens.text-disabled; vertical-alignment: center; }
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 3px;
                        background: Tokens.accent-bloom-pressed;
                        border-width: 1px;
                        border-color: Tokens.accent-bloom-hover;
                        TouchArea { clicked => { root.set_selected_color(Tokens.accent-bloom-pressed); } }
                    }
                }

                Rectangle { width: 1px; height: 18px; background: Tokens.border-subtle; y: 10px; }

                // Curve operations
                StudioIconButton {
                    icon: IconSet.PenTool;
                    tooltip: "Converter em Curvas (Ctrl+Return)";
                    clicked => { root.convert_to_curves_clicked(); }
                }
                StudioIconButton {
                    icon: IconSet.Maximize2;
                    tooltip: "Bake Cantos";
                    clicked => { root.bake_corners_clicked(); }
                }
                StudioIconButton {
                    icon: IconSet.CircleDotDashed;
                    tooltip: "Bake Contour (aplica offset vivo)";
                    clicked => { root.bake_contour_clicked(); }
                }

                Rectangle { width: 1px; height: 18px; background: Tokens.border-subtle; y: 10px; }

                // Boolean Operations (10.3)
                HorizontalLayout {
                    spacing: 2px;
                    alignment: center;

                    StudioIconButton {
                        icon: IconSet.Combine;
                        tooltip: "União (Boolean Union)";
                        clicked => { root.boolean_union_clicked(); }
                    }
                    StudioIconButton {
                        icon: IconSet.Minus;
                        tooltip: "Subtração (Boolean Subtract)";
                        clicked => { root.boolean_subtract_clicked(); }
                    }
                    StudioIconButton {
                        icon: IconSet.Square;
                        tooltip: "Intersecção (Boolean Intersect)";
                        clicked => { root.boolean_intersect_clicked(); }
                    }
                    StudioIconButton {
                        icon: IconSet.Circle;
                        tooltip: "Exclusão / Xor";
                        clicked => { root.boolean_xor_clicked(); }
                    }
                }

                Rectangle { width: 1px; height: 18px; background: Tokens.border-subtle; y: 10px; }

                // Alignments (10.1)
                HorizontalLayout {
                    spacing: 2px;
                    alignment: center;

                    StudioIconButton { icon: IconSet.AlignLeft; tooltip: "Alinhar à Esquerda"; clicked => { root.align_objects_clicked("Left"); } }
                    StudioIconButton { icon: IconSet.AlignCenterHorizontal; tooltip: "Alinhar ao Centro H"; clicked => { root.align_objects_clicked("Center"); } }
                    StudioIconButton { icon: IconSet.AlignRight; tooltip: "Alinhar à Direita"; clicked => { root.align_objects_clicked("Right"); } }
                    StudioIconButton { icon: IconSet.AlignStartVertical; tooltip: "Alinhar ao Topo"; clicked => { root.align_objects_clicked("Top"); } }
                    StudioIconButton { icon: IconSet.AlignCenterVertical; tooltip: "Alinhar ao Meio V"; clicked => { root.align_objects_clicked("Middle"); } }
                    StudioIconButton { icon: IconSet.AlignEndVertical; tooltip: "Alinhar à Base"; clicked => { root.align_objects_clicked("Bottom"); } }
                }

                Rectangle { horizontal-stretch: 1; }

                // Export quick action
                StudioIconButton {
                    icon: IconSet.FileCode;
                    tooltip: "Exportar Documento (Ctrl+E)";
                    clicked => { root.open_export_dialog_clicked(); }
                }

                // Delete quick action
                StudioIconButton {
                    icon: IconSet.Trash;
                    tooltip: "Excluir Seleção (Delete)";
                    clicked => { root.delete_selected_clicked(); }
                }
            }
        }

        Rectangle { height: 1px; background: Tokens.border-subtle; }

        // -------------------------------------------------------------
        // SECTION 4: MAIN WORKSPACE (TOOL RAIL + CANVAS + DOCK)
        // -------------------------------------------------------------
        HorizontalLayout {
            spacing: 0px;

            // 4.1 CANONICAL LEFT TOOL RAIL (48px) (08.7, 08.24)
            Rectangle {
                width: 48px;
                background: Tokens.surface-chrome;

                VerticalLayout {
                    padding-top: 6px;
                    padding-bottom: 6px;
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    alignment: start;

                    // Group 1: Selection
                    StudioToolButton {
                        icon: IconSet.MousePointer2;
                        active: root.active_tool_name == "Select";
                        shortcut: "V";
                        clicked => { root.active_tool_name = "Select"; root.select_tool("Select"); }
                    }
                    StudioToolButton {
                        icon: IconSet.Pointer;
                        active: root.active_tool_name == "Node";
                        shortcut: "A";
                        clicked => { root.active_tool_name = "Node"; root.select_tool("Node"); }
                    }
                    StudioToolButton {
                        icon: IconSet.Move;
                        active: root.active_tool_name == "PointTransform";
                        shortcut: "F";
                        clicked => { root.active_tool_name = "PointTransform"; root.select_tool("PointTransform"); }
                    }
                    StudioToolButton {
                        icon: IconSet.Crop;
                        active: root.active_tool_name == "Artboard";
                        shortcut: "H";
                        clicked => { root.active_tool_name = "Artboard"; root.select_tool("Artboard"); }
                    }

                    // Divider
                    Rectangle { height: 1px; background: Tokens.border-subtle; }

                    // Group 2: Vector Drawing
                    StudioToolButton {
                        icon: IconSet.PenTool;
                        active: root.active_tool_name == "Pen";
                        shortcut: "P";
                        clicked => { root.active_tool_name = "Pen"; root.select_tool("Pen"); }
                    }
                    StudioToolButton {
                        icon: IconSet.Pencil;
                        active: root.active_tool_name == "Pencil";
                        shortcut: "N";
                        clicked => { root.active_tool_name = "Pencil"; root.select_tool("Pencil"); }
                    }
                    StudioToolButton {
                        icon: IconSet.Square;
                        active: root.active_tool_name == "Rectangle";
                        shortcut: "M";
                        clicked => { root.active_tool_name = "Rectangle"; root.select_tool("Rectangle"); }
                    }
                    StudioToolButton {
                        icon: IconSet.Circle;
                        active: root.active_tool_name == "Ellipse";
                        shortcut: "E";
                        clicked => { root.active_tool_name = "Ellipse"; root.select_tool("Ellipse"); }
                    }
                    StudioToolButton {
                        icon: IconSet.Star;
                        active: root.active_tool_name == "Star";
                        shortcut: "S";
                        clicked => { root.active_tool_name = "Star"; root.select_tool("Star"); }
                    }
                    StudioToolButton {
                        icon: IconSet.Hexagon;
                        active: root.active_tool_name == "Polygon";
                        shortcut: "Y";
                        clicked => { root.active_tool_name = "Polygon"; root.select_tool("Polygon"); }
                    }

                    // Divider
                    Rectangle { height: 1px; background: Tokens.border-subtle; }

                    // Group 3: Typography & Content
                    StudioToolButton {
                        icon: IconSet.Type;
                        active: root.active_tool_name == "Text";
                        shortcut: "T";
                        clicked => { root.active_tool_name = "Text"; root.select_tool("Text"); }
                    }
                    StudioToolButton {
                        icon: IconSet.Palette;
                        active: root.active_tool_name == "Gradient";
                        shortcut: "G";
                        clicked => { root.active_tool_name = "Gradient"; root.select_tool("Gradient"); }
                    }
                    StudioToolButton {
                        icon: IconSet.Pipette;
                        active: root.active_tool_name == "ColorPicker";
                        shortcut: "I";
                        clicked => { root.active_tool_name = "ColorPicker"; root.select_tool("ColorPicker"); }
                    }

                    // Divider
                    Rectangle { height: 1px; background: Tokens.border-subtle; }

                    // Group 4: Vector Editing
                    StudioToolButton {
                        icon: IconSet.Sparkles;
                        active: root.active_tool_name == "Corner";
                        shortcut: "C";
                        clicked => { root.active_tool_name = "Corner"; root.select_tool("Corner"); }
                    }
                    StudioToolButton {
                        icon: IconSet.Slice;
                        active: root.active_tool_name == "Knife";
                        shortcut: "K";
                        clicked => { root.active_tool_name = "Knife"; root.select_tool("Knife"); }
                    }
                    StudioToolButton {
                        icon: IconSet.Scissors;
                        active: root.active_tool_name == "Scissors";
                        shortcut: "Shift+K";
                        clicked => { root.active_tool_name = "Scissors"; root.select_tool("Scissors"); }
                    }
                    StudioToolButton {
                        icon: IconSet.Combine;
                        active: root.active_tool_name == "ShapeBuilder";
                        shortcut: "W";
                        clicked => { root.active_tool_name = "ShapeBuilder"; root.select_tool("ShapeBuilder"); }
                    }

                    // Divider
                    Rectangle { height: 1px; background: Tokens.border-subtle; }

                    // Group 5: Viewport Navigation
                    StudioToolButton {
                        icon: IconSet.Hand;
                        active: root.active_tool_name == "Hand";
                        shortcut: "Space";
                        clicked => { root.active_tool_name = "Hand"; root.select_tool("Hand"); }
                    }
                    StudioToolButton {
                        icon: IconSet.ZoomIn;
                        active: root.active_tool_name == "Zoom";
                        shortcut: "Z";
                        clicked => { root.active_tool_name = "Zoom"; root.select_tool("Zoom"); }
                    }
                }
            }

            Rectangle { width: 1px; background: Tokens.surface-control; }

            // 4.1b RULER COLUMN (Affinity chrome, document coords)
            VerticalLayout {
                spacing: 0px;
                Rectangle { width: 22px; height: 18px; background: Tokens.surface-chrome-strong; }
                Rectangle {
                    width: 22px;
                    vertical-stretch: 1;
                    background: Tokens.surface-chrome-strong;
                    clip: true;
                    for i in 90 : Rectangle {
                        y: i * 10px;
                        width: 22px;
                        height: 1px;
                        background: transparent;
                        Rectangle {
                            x: 22px - (Math.mod(i, 10) == 0 ? 10px : (Math.mod(i, 5) == 0 ? 6px : 3px));
                            width: (Math.mod(i, 10) == 0 ? 10px : (Math.mod(i, 5) == 0 ? 6px : 3px));
                            height: 1px;
                            background: Tokens.border-strong;
                        }
                        if Math.mod(i * 10 - Math.round(root.artboard_y / 1px), 100) == 0 && i * 10 >= Math.round(root.artboard_y / 1px) : Text {
                            text: (i * 10 - Math.round(root.artboard_y / 1px)) + "";
                            font-size: 8px;
                            color: Tokens.text-disabled;
                            x: 1px;
                            y: i * 10px - 9px;
                        }
                    }
                }
            }

            // 4.1c CANVAS COLUMN with horizontal ruler
            VerticalLayout {
                spacing: 0px;
                horizontal-stretch: 1;

                Rectangle {
                    height: 18px;
                    background: Tokens.surface-chrome-strong;
                    clip: true;
                    for i in 130 : Rectangle {
                        x: i * 10px;
                        height: 18px;
                        width: 1px;
                        background: transparent;
                        Rectangle {
                            y: 18px - (Math.mod(i, 10) == 0 ? 10px : (Math.mod(i, 5) == 0 ? 6px : 3px));
                            width: 1px;
                            height: (Math.mod(i, 10) == 0 ? 10px : (Math.mod(i, 5) == 0 ? 6px : 3px));
                            background: Tokens.border-strong;
                        }
                        if Math.mod(i * 10 - Math.round(root.artboard_x / 1px), 100) == 0 && i * 10 >= Math.round(root.artboard_x / 1px) : Text {
                            text: (i * 10 - Math.round(root.artboard_x / 1px)) + "";
                            font-size: 8px;
                            color: Tokens.text-disabled;
                            x: i * 10px + 2px;
                            y: 1px;
                        }
                    }
                }

            // 4.2 CENTRAL CANVAS VIEWPORT (08.6)
            canvas_viewport := Rectangle {
                horizontal-stretch: 1;
                background: Tokens.surface-workspace;
                clip: true;

                // Document Artboard Drop Shadow
                Rectangle {
                    x: root.artboard_x + 6px;
                    y: root.artboard_y + 6px;
                    width: root.artboard_w;
                    height: root.artboard_h;
                    background: Tokens.scrim;
                    border-radius: 4px;
                }

                // Magenta Bleed Guideline (08.27, 10.7)
                Rectangle {
                    x: root.artboard_x - root.bleed_margin;
                    y: root.artboard_y - root.bleed_margin;
                    width: root.artboard_w + (root.bleed_margin * 2);
                    height: root.artboard_h + (root.bleed_margin * 2);
                    border-width: 1px;
                    border-color: Tokens.studio-photo;
                }

                // Main Paper Artboard (White)
                main_artboard := Rectangle {
                    x: root.artboard_x;
                    y: root.artboard_y;
                    width: root.artboard_w;
                    height: root.artboard_h;
                    background: Tokens.text-primary;

                    // Cyan Margins Inset Guideline (10.7)
                    Rectangle {
                        x: root.margin_inset;
                        y: root.margin_inset;
                        width: parent.width - (root.margin_inset * 2);
                        height: parent.height - (root.margin_inset * 2);
                        border-width: 1px;
                        border-color: Tokens.studio-design;
                    }

                    // Vertical Layout Guide
                    Rectangle {
                        x: root.guide_x;
                        y: 0px;
                        width: 1px;
                        height: parent.height;
                        background: Tokens.studio-design;
                    }

                    // Dynamic Artwork Objects Rendered on Artboard
                    for obj in root.canvas_objects : Rectangle {
                        x: obj.x;
                        y: obj.y;
                        width: obj.w;
                        height: obj.h;
                        background: transparent;
                        opacity: obj.opacity;

                        // Vector Path rendering (Pen, Pencil, Star, Polygon, Curves, rotated shapes)
                        if obj.is_path : Path {
                            width: parent.width;
                            height: parent.height;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: Math.max(1, obj.w / 1px);
                            viewbox-height: Math.max(1, obj.h / 1px);
                            commands: obj.svg_path;
                            fill: obj.bg_color;
                            stroke: obj.stroke_color;
                            stroke-width: obj.stroke_width;
                        }

                        // Ellipse / Circle rendering
                        if obj.is_circle : Rectangle {
                            width: parent.width;
                            height: parent.height;
                            background: obj.bg_color;
                            border-radius: Math.min(parent.width, parent.height) / 2;
                            border-color: obj.stroke_color;
                            border-width: obj.stroke_width;
                        }

                        // Parametric Rectangle rendering
                        if !obj.is_path && !obj.is_circle && !obj.is_text : Rectangle {
                            width: parent.width;
                            height: parent.height;
                            background: obj.bg_color;
                            border-radius: obj.corner_radius;
                            border-color: obj.stroke_color;
                            border-width: obj.stroke_width;
                        }

                        // Text content if text object
                        if obj.is_text : Text {
                            text: obj.text_content;
                            color: obj.text_color;
                            font-size: obj.text_size * 1px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        // Interactive Selection Affordances (8 Handles + Box) (10.1)
                        if obj.selected : Rectangle {
                            x: -2px;
                            y: -2px;
                            width: parent.width + 4px;
                            height: parent.height + 4px;
                            border-width: 1.5px;
                            border-color: Tokens.accent-bloom;

                            // 8 Resize Handles
                            Rectangle { x: -4px; y: -4px; width: 8px; height: 8px; background: Tokens.text-primary; border-width: 1px; border-color: Tokens.accent-bloom-pressed; }
                            Rectangle { x: (parent.width - 8px) / 2; y: -4px; width: 8px; height: 8px; background: Tokens.text-primary; border-width: 1px; border-color: Tokens.accent-bloom-pressed; }
                            Rectangle { x: parent.width - 4px; y: -4px; width: 8px; height: 8px; background: Tokens.text-primary; border-width: 1px; border-color: Tokens.accent-bloom-pressed; }
                            Rectangle { x: parent.width - 4px; y: (parent.height - 8px) / 2; width: 8px; height: 8px; background: Tokens.text-primary; border-width: 1px; border-color: Tokens.accent-bloom-pressed; }
                            Rectangle { x: parent.width - 4px; y: parent.height - 4px; width: 8px; height: 8px; background: Tokens.text-primary; border-width: 1px; border-color: Tokens.accent-bloom-pressed; }
                            Rectangle { x: (parent.width - 8px) / 2; y: parent.height - 4px; width: 8px; height: 8px; background: Tokens.text-primary; border-width: 1px; border-color: Tokens.accent-bloom-pressed; }
                            Rectangle { x: -4px; y: parent.height - 4px; width: 8px; height: 8px; background: Tokens.text-primary; border-width: 1px; border-color: Tokens.accent-bloom-pressed; }
                            Rectangle { x: -4px; y: (parent.height - 8px) / 2; width: 8px; height: 8px; background: Tokens.text-primary; border-width: 1px; border-color: Tokens.accent-bloom-pressed; }

                            // Top Rotation Pin Stem & Handle
                            Rectangle { x: (parent.width - 1px) / 2; y: -20px; width: 1px; height: 16px; background: Tokens.accent-bloom; }
                            Rectangle { x: (parent.width - 8px) / 2; y: -24px; width: 8px; height: 8px; border-radius: 4px; background: Tokens.accent-bloom; border-width: 1px; border-color: Tokens.text-primary; }

                            // Dimensions Readout HUD
                            Rectangle {
                                x: (parent.width - 130px) / 2;
                                y: parent.height + 8px;
                                width: 130px;
                                height: 20px;
                                border-radius: 4px;
                                background: Tokens.surface-panel;
                                border-width: 1px;
                                border-color: Tokens.accent-bloom;

                                Text {
                                    text: Math.round(obj.w / 1px) + " × " + Math.round(obj.h / 1px) + " pt";
                                    font-size: 10px;
                                    color: Tokens.accent-bloom-hover;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Interactive drag creation preview
                    if root.has_preview : Rectangle {
                        x: root.preview_x;
                        y: root.preview_y;
                        width: root.preview_w;
                        height: root.preview_h;
                        background: Tokens.accent-faint;
                        border-width: 1px;
                        border-color: Tokens.accent-bloom;
                    }
                }

                // Interactive Canvas Pointer Area
                canvas_touch := TouchArea {
                    mouse-cursor: root.canvas_cursor_kind == "nwse-resize" ? MouseCursor.nwse-resize :
                                  root.canvas_cursor_kind == "nesw-resize" ? MouseCursor.nesw-resize :
                                  root.canvas_cursor_kind == "ns-resize" ? MouseCursor.ns-resize :
                                  root.canvas_cursor_kind == "ew-resize" ? MouseCursor.ew-resize :
                                  root.canvas_cursor_kind == "crosshair" ? MouseCursor.crosshair :
                                  root.canvas_cursor_kind == "grab" ? MouseCursor.grab :
                                  root.canvas_cursor_kind == "text" ? MouseCursor.text :
                                  MouseCursor.default;

                    pointer-event(ev) => {
                        root_fs.focus();
                        if (ev.kind == PointerEventKind.down) {
                            root.canvas_pointer_down(self.mouse-x, self.mouse-y);
                        }
                        if (ev.kind == PointerEventKind.up) {
                            root.canvas_pointer_up(self.mouse-x, self.mouse-y);
                        }
                    }
                    moved => {
                        root.canvas_dragged(self.mouse-x, self.mouse-y);
                        root.status_coords = "Doc: X: " + Math.round(self.mouse-x / 1px) + " pt  Y: " + Math.round(self.mouse-y / 1px) + " pt";
                    }
                }
            }

            } // end canvas column VerticalLayout

            Rectangle { width: 1px; background: Tokens.surface-control; }

            // 4.3 RIGHT STUDIO DOCK (320px) (08.3, 08.25)
            Rectangle {
                width: 320px;
                background: Tokens.surface-chrome;

                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;

                    // Studio Dock Tabs Header
                    Rectangle {
                        height: 36px;
                        background: Tokens.surface-chrome;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 4px;
                            alignment: center;

                            Rectangle {
                                height: 28px;
                                border-radius: 4px;
                                background: root.active_tab_index == 0 ? Tokens.surface-control : transparent;
                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 10px; spacing: 4px; alignment: center;
                                    IconDisplay { icon: IconSet.Layers; size: 12px; stroke: root.active_tab_index == 0 ? Tokens.accent-bloom-hover : Tokens.text-disabled; y: 8px; }
                                    Text { text: "Camadas"; font-size: 12px; color: root.active_tab_index == 0 ? Tokens.text-primary : Tokens.text-tertiary; font-weight: root.active_tab_index == 0 ? 600 : 400; vertical-alignment: center; }
                                }
                                TouchArea { clicked => { root.active_tab_index = 0; root.tab_changed(0); } }
                            }

                            Rectangle {
                                height: 28px;
                                border-radius: 4px;
                                background: root.active_tab_index == 1 ? Tokens.surface-control : transparent;
                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 10px; spacing: 4px; alignment: center;
                                    IconDisplay { icon: IconSet.Sliders; size: 12px; stroke: root.active_tab_index == 1 ? Tokens.accent-bloom-hover : Tokens.text-disabled; y: 8px; }
                                    Text { text: "Propriedades"; font-size: 12px; color: root.active_tab_index == 1 ? Tokens.text-primary : Tokens.text-tertiary; font-weight: root.active_tab_index == 1 ? 600 : 400; vertical-alignment: center; }
                                }
                                TouchArea { clicked => { root.active_tab_index = 1; root.tab_changed(1); } }
                            }

                            Rectangle {
                                height: 28px;
                                border-radius: 4px;
                                background: root.active_tab_index == 2 ? Tokens.surface-control : transparent;
                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 10px; spacing: 4px; alignment: center;
                                    IconDisplay { icon: IconSet.Undo2; size: 12px; stroke: root.active_tab_index == 2 ? Tokens.accent-bloom-hover : Tokens.text-disabled; y: 8px; }
                                    Text { text: "Histórico"; font-size: 12px; color: root.active_tab_index == 2 ? Tokens.text-primary : Tokens.text-tertiary; font-weight: root.active_tab_index == 2 ? 600 : 400; vertical-alignment: center; }
                                }
                                TouchArea { clicked => { root.active_tab_index = 2; root.tab_changed(2); } }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Tokens.border-subtle; }

                    // TAB 0: LAYERS PANEL
                    if root.active_tab_index == 0 : VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Hierarquia de Objetos";
                                font-size: 13px;
                                font-weight: 700;
                                color: Tokens.text-primary;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.layer_rows.length + " itens";
                                font-size: 11px;
                                color: Tokens.text-disabled;
                                vertical-alignment: center;
                            }
                        }

                        // Artboard row item
                        Rectangle {
                            height: 28px;
                            border-radius: 4px;
                            background: Tokens.surface-panel-raised;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                IconDisplay { icon: IconSet.FileCode; size: 13px; stroke: Tokens.accent-bloom-hover; y: 8px; }
                                Text { text: "📄 Main Artboard [800 × 600]"; font-size: 12px; color: Tokens.accent-bloom-hover; font-weight: 600; vertical-alignment: center; }
                            }
                        }

                        // Hierarchy Actions Toolbar (10.5)
                        HorizontalLayout {
                            spacing: 4px;
                            Button { text: "Agrupar"; clicked => { root.group_selected_clicked(); } }
                            Button { text: "Desagrupar"; clicked => { root.ungroup_selected_clicked(); } }
                            Button { text: "Máscara"; clicked => { root.create_clip_mask_clicked(); } }
                            Button { text: "Soltar"; clicked => { root.release_clip_mask_clicked(); } }
                        }

                        // Layers list
                        ScrollView {
                            height: 380px;
                            VerticalLayout {
                                spacing: 4px;
                                for item[idx] in root.layer_rows : Rectangle {
                                    height: 34px;
                                    border-radius: 4px;
                                    background: item.selected ? Tokens.accent-selection-soft : Tokens.surface-panel;
                                    border-width: item.selected ? 1px : 0px;
                                    border-color: Tokens.accent-bloom;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        alignment: center;

                                        // Hierarchy nesting indentation
                                        if item.depth > 0px : Rectangle {
                                            width: item.depth;
                                        }

                                        // Mask clipping indicator
                                        if item.is_clipped : Text {
                                            text: "⤷";
                                            font-size: 11px;
                                            color: Tokens.accent-bloom;
                                            vertical-alignment: center;
                                        }

                                        // Layer kind icon
                                        IconDisplay {
                                            icon: item.is_clip_mask ? IconSet.Scissors :
                                                  item.is_container ? IconSet.Layers :
                                                  item.kind == "Ellipse" ? IconSet.Circle :
                                                  item.kind == "Text" ? IconSet.Type :
                                                  item.kind == "Star" ? IconSet.Star : IconSet.Square;
                                            size: 13px;
                                            stroke: item.is_clip_mask ? Tokens.accent-bloom :
                                                    item.is_container ? Tokens.studio-design :
                                                    item.selected ? Tokens.accent-bloom-hover : Tokens.text-tertiary;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        // Layer name & container badge
                                        TouchArea {
                                            horizontal-stretch: 1;
                                            clicked => { root.select_layer_by_index(idx); }
                                            HorizontalLayout {
                                                spacing: 4px;
                                                alignment: start;
                                                Text {
                                                    text: item.name;
                                                    font-size: 12px;
                                                    font-weight: item.selected ? 600 : 400;
                                                    color: item.selected ? Tokens.text-primary : Tokens.text-secondary;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    horizontal-stretch: 1;
                                                }
                                                if item.is_clip_mask : Rectangle {
                                                    height: 16px;
                                                    border-radius: 3px;
                                                    background: Tokens.accent-faint;
                                                    border-width: 1px;
                                                    border-color: Tokens.accent-bloom;
                                                    HorizontalLayout {
                                                        padding-left: 4px; padding-right: 4px;
                                                        Text { text: "MÁSCARA"; font-size: 9px; font-weight: 700; color: Tokens.accent-bloom; vertical-alignment: center; }
                                                    }
                                                }
                                                if item.is_container : Rectangle {
                                                    height: 16px;
                                                    border-radius: 3px;
                                                    background: Tokens.accent-faint;
                                                    border-width: 1px;
                                                    border-color: Tokens.studio-design;
                                                    HorizontalLayout {
                                                        padding-left: 4px; padding-right: 4px;
                                                        Text { text: "GRUPO"; font-size: 9px; font-weight: 700; color: Tokens.studio-design; vertical-alignment: center; }
                                                    }
                                                }
                                            }
                                        }

                                        // Visibility toggle button
                                        Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            border-radius: 3px;
                                            background: touch_vis.has-hover ? Tokens.overlay-hover : transparent;
                                            IconDisplay {
                                                icon: item.visible ? IconSet.Eye : IconSet.EyeOff;
                                                size: 13px;
                                                stroke: item.visible ? Tokens.text-tertiary : Tokens.text-disabled;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            touch_vis := TouchArea { clicked => { root.toggle_layer_visibility(idx); } }
                                        }

                                        // Lock toggle button
                                        Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            border-radius: 3px;
                                            background: touch_lock.has-hover ? Tokens.overlay-hover : transparent;
                                            IconDisplay {
                                                icon: item.locked ? IconSet.Lock : IconSet.LockOpen;
                                                size: 13px;
                                                stroke: item.locked ? Tokens.status-warning : Tokens.text-disabled;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            touch_lock := TouchArea { clicked => { root.toggle_layer_lock(idx); } }
                                        }

                                        // Reorder Up
                                        Rectangle {
                                            width: 18px;
                                            height: 22px;
                                            border-radius: 3px;
                                            background: touch_up.has-hover ? Tokens.overlay-hover : transparent;
                                            IconDisplay { icon: IconSet.ChevronFirst; size: 11px; stroke: Tokens.text-disabled; x: 4px; y: 6px; }
                                            touch_up := TouchArea { clicked => { root.reorder_layer_up(idx); } }
                                        }

                                        // Reorder Down
                                        Rectangle {
                                            width: 18px;
                                            height: 22px;
                                            border-radius: 3px;
                                            background: touch_dn.has-hover ? Tokens.overlay-hover : transparent;
                                            IconDisplay { icon: IconSet.ChevronLast; size: 11px; stroke: Tokens.text-disabled; x: 4px; y: 6px; }
                                            touch_dn := TouchArea { clicked => { root.reorder_layer_down(idx); } }
                                        }
                                    }
                                }
                            }
                        }

                        // Layer Actions Footer
                        Rectangle { height: 1px; background: Tokens.border-subtle; }
                        HorizontalLayout {
                            spacing: 6px;
                            Button { text: "+ Retângulo"; clicked => { root.add_rectangle_clicked(); } }
                            Button { text: "+ Elipse"; clicked => { root.add_circle_clicked(); } }
                            Button { text: "+ Texto"; clicked => { root.add_text_clicked(); } }
                        }
                    }

                    // TAB 1: PROPERTIES INSPECTOR (08.25)
                    if root.active_tab_index == 1 : ScrollView {
                        VerticalLayout {
                            padding: 10px;
                            spacing: 12px;

                            // Transform Group
                            Rectangle {
                                background: Tokens.surface-panel;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Tokens.border-subtle;

                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 8px;

                                    Text { text: "TRANSFORMAÇÃO"; font-size: 11px; font-weight: 700; color: Tokens.text-tertiary; }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text { text: "X (pt)"; font-size: 10px; color: Tokens.text-disabled; }
                                            LineEdit {
                                                height: 26px;
                                                text: "" + Math.round(root.prop_x / 1px);
                                                accepted(t) => { root.commit_prop_x(t); }
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text { text: "Y (pt)"; font-size: 10px; color: Tokens.text-disabled; }
                                            LineEdit {
                                                height: 26px;
                                                text: "" + Math.round(root.prop_y / 1px);
                                                accepted(t) => { root.commit_prop_y(t); }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text { text: "Largura (W)"; font-size: 10px; color: Tokens.text-disabled; }
                                            LineEdit {
                                                height: 26px;
                                                text: "" + Math.round(root.prop_w / 1px);
                                                accepted(t) => { root.commit_prop_w(t); }
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text { text: "Altura (H)"; font-size: 10px; color: Tokens.text-disabled; }
                                            LineEdit {
                                                height: 26px;
                                                text: "" + Math.round(root.prop_h / 1px);
                                                accepted(t) => { root.commit_prop_h(t); }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text { text: "Rotação (°)"; font-size: 10px; color: Tokens.text-disabled; }
                                            LineEdit {
                                                height: 26px;
                                                text: "" + Math.round(root.prop_rot);
                                                accepted(t) => { root.commit_prop_rot(t); }
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text { text: "Traço (pt)"; font-size: 10px; color: Tokens.text-disabled; }
                                            LineEdit {
                                                height: 26px;
                                                text: "" + Math.round(root.prop_stroke_width * 10) / 10;
                                                accepted(t) => {
                                                    // parse via opacity-style float commit
                                                    root.set_stroke_width_value(t.to-float());
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Appearance & Colors Group (10.4)
                            Rectangle {
                                background: Tokens.surface-panel;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Tokens.border-subtle;

                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 10px;

                                    // 1. Swatches & Solid Colors
                                    Text { text: "PREENCHIMENTO (SWATCHES)"; font-size: 11px; font-weight: 700; color: Tokens.text-tertiary; }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        Rectangle { width: 24px; height: 24px; border-radius: 4px; background: Tokens.accent-bloom; TouchArea { clicked => { root.set_selected_color(Tokens.accent-bloom); } } }
                                        Rectangle { width: 24px; height: 24px; border-radius: 4px; background: Tokens.status-warning; TouchArea { clicked => { root.set_selected_color(Tokens.status-warning); } } }
                                        Rectangle { width: 24px; height: 24px; border-radius: 4px; background: Tokens.status-error; TouchArea { clicked => { root.set_selected_color(Tokens.status-error); } } }
                                        Rectangle { width: 24px; height: 24px; border-radius: 4px; background: Tokens.status-success; TouchArea { clicked => { root.set_selected_color(Tokens.status-success); } } }
                                        Rectangle { width: 24px; height: 24px; border-radius: 4px; background: Tokens.accent-bloom; TouchArea { clicked => { root.set_selected_color(Tokens.accent-bloom); } } }
                                        Rectangle { width: 24px; height: 24px; border-radius: 4px; background: Tokens.text-primary; TouchArea { clicked => { root.set_selected_color(Tokens.text-primary); } } }
                                        Rectangle { width: 24px; height: 24px; border-radius: 4px; background: Tokens.surface-chrome-strong; border-width: 1px; border-color: Tokens.border-strong; TouchArea { clicked => { root.set_selected_color(Tokens.surface-chrome-strong); } } }
                                    }

                                    // 2. Gradients & Paint Styles
                                    Text { text: "ESTILO DE PINTURA & GRADIENTES"; font-size: 11px; font-weight: 700; color: Tokens.text-tertiary; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Button { text: "Sólido"; clicked => { root.set_gradient_clicked("solid"); } }
                                        Button { text: "Grad Linear"; clicked => { root.set_gradient_clicked("linear"); } }
                                        Button { text: "Grad Radial"; clicked => { root.set_gradient_clicked("radial"); } }
                                    }

                                    // 3. Blend Modes (16 W3C Modes)
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "MODO DE MESCLAGEM:"; font-size: 11px; font-weight: 700; color: Tokens.text-tertiary; vertical-alignment: center; }
                                        Rectangle {
                                            height: 20px;
                                            border-radius: 4px;
                                            background: Tokens.accent-faint;
                                            border-width: 1px;
                                            border-color: Tokens.accent-bloom;
                                            HorizontalLayout {
                                                padding-left: 6px; padding-right: 6px;
                                                Text { text: root.prop_blend_mode; font-size: 11px; font-weight: 700; color: Tokens.accent-bloom-hover; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        Button { text: "Normal"; clicked => { root.set_blend_mode_clicked("Normal"); } }
                                        Button { text: "Multiplicar"; clicked => { root.set_blend_mode_clicked("Multiply"); } }
                                        Button { text: "Tela"; clicked => { root.set_blend_mode_clicked("Screen"); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        Button { text: "Sobrepor"; clicked => { root.set_blend_mode_clicked("Overlay"); } }
                                        Button { text: "Diferença"; clicked => { root.set_blend_mode_clicked("Difference"); } }
                                        Button { text: "Escurecer"; clicked => { root.set_blend_mode_clicked("Darken"); } }
                                    }

                                    // 4. Opacity Slider
                                    Text { text: "OPACIDADE GERAL: " + Math.round(root.selected_opacity) + "%"; font-size: 11px; font-weight: 700; color: Tokens.text-tertiary; }
                                    Slider {
                                        value: root.selected_opacity;
                                        minimum: 0.0;
                                        maximum: 100.0;
                                        changed(val) => {
                                            root.selected_opacity = val;
                                            root.set_opacity_value(val);
                                        }
                                    }

                                    Rectangle { height: 1px; background: Tokens.border-subtle; }

                                    // 5. Multiple Fills Stack
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "PREENCHIMENTOS (" + root.prop_fills.length + ")"; font-size: 11px; font-weight: 700; color: Tokens.text-tertiary; vertical-alignment: center; }
                                        Button { text: "+ Preenchimento"; clicked => { root.add_fill_clicked(); } }
                                    }
                                    for fill in root.prop_fills : Rectangle {
                                        height: 28px;
                                        border-radius: 4px;
                                        background: Tokens.surface-chrome-strong;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;
                                            alignment: center;
                                            IconDisplay { icon: IconSet.Palette; size: 12px; stroke: Tokens.accent-bloom-hover; y: 8px; }
                                            Text { text: "Fill #" + fill.id + " [" + fill.paint_type + "]"; font-size: 11px; color: Tokens.text-secondary; vertical-alignment: center; horizontal-stretch: 1; }
                                            Text { text: fill.opacity_pct + "%"; font-size: 10px; color: Tokens.text-disabled; vertical-alignment: center; }
                                            Rectangle {
                                                width: 18px; height: 18px; border-radius: 3px; background: touch_rf.has-hover ? Tokens.status-error : transparent;
                                                IconDisplay { icon: IconSet.Trash; size: 10px; stroke: Tokens.status-error; x: 4px; y: 4px; }
                                                touch_rf := TouchArea { clicked => { root.remove_fill_clicked(fill.id); } }
                                            }
                                        }
                                    }

                                    Rectangle { height: 1px; background: Tokens.border-subtle; }

                                    // 6. Multiple Strokes Stack
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "TRAÇADOS (" + root.prop_strokes.length + ")"; font-size: 11px; font-weight: 700; color: Tokens.text-tertiary; vertical-alignment: center; }
                                        Button { text: "+ Traçado"; clicked => { root.add_stroke_clicked(); } }
                                    }
                                    for stroke in root.prop_strokes : Rectangle {
                                        height: 28px;
                                        border-radius: 4px;
                                        background: Tokens.surface-chrome-strong;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;
                                            alignment: center;
                                            IconDisplay { icon: IconSet.Pen; size: 12px; stroke: Tokens.accent-bloom; y: 8px; }
                                            Text { text: "Traço #" + stroke.id + " (" + Math.round(stroke.width_pt) + " pt)"; font-size: 11px; color: Tokens.text-secondary; vertical-alignment: center; horizontal-stretch: 1; }
                                            Text { text: stroke.opacity_pct + "%"; font-size: 10px; color: Tokens.text-disabled; vertical-alignment: center; }
                                            Rectangle {
                                                width: 18px; height: 18px; border-radius: 3px; background: touch_rs.has-hover ? Tokens.status-error : transparent;
                                                IconDisplay { icon: IconSet.Trash; size: 10px; stroke: Tokens.status-error; x: 4px; y: 4px; }
                                                touch_rs := TouchArea { clicked => { root.remove_stroke_clicked(stroke.id); } }
                                            }
                                        }
                                    }
                                }
                            }

                            // Pathfinder & Booleans
                            Rectangle {
                                background: Tokens.surface-panel;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Tokens.border-subtle;

                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 8px;

                                    Text { text: "BOOLEANOS & PATHFINDER (10.3)"; font-size: 11px; font-weight: 700; color: Tokens.text-tertiary; }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        Button { text: "⋃ Unir"; clicked => { root.boolean_union_clicked(); } }
                                        Button { text: "− Subtrair"; clicked => { root.boolean_subtract_clicked(); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Button { text: "⋂ Interseção"; clicked => { root.boolean_intersect_clicked(); } }
                                        Button { text: "⨁ Exclusão"; clicked => { root.boolean_xor_clicked(); } }
                                    }
                                }
                            }

                            // Alignment & Distribution
                            Rectangle {
                                background: Tokens.surface-panel;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Tokens.border-subtle;

                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 8px;

                                    Text { text: "ALINHAMENTO & DISTRIBUIÇÃO (10.1)"; font-size: 11px; font-weight: 700; color: Tokens.text-tertiary; }

                                    HorizontalLayout {
                                        spacing: 4px;
                                        Button { text: "Esq"; clicked => { root.align_objects_clicked("Left"); } }
                                        Button { text: "Centro"; clicked => { root.align_objects_clicked("Center"); } }
                                        Button { text: "Dir"; clicked => { root.align_objects_clicked("Right"); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        Button { text: "Topo"; clicked => { root.align_objects_clicked("Top"); } }
                                        Button { text: "Meio"; clicked => { root.align_objects_clicked("Middle"); } }
                                        Button { text: "Base"; clicked => { root.align_objects_clicked("Bottom"); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        Button { text: "Distribuir H"; clicked => { root.distribute_objects_clicked("Horizontal"); } }
                                        Button { text: "Distribuir V"; clicked => { root.distribute_objects_clicked("Vertical"); } }
                                    }
                                }
                            }
                        }
                    }

                    // TAB 2: HISTORY PANEL
                    if root.active_tab_index == 2 : VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        Text { text: "Histórico de Ações (Undo/Redo)"; font-size: 13px; font-weight: 700; color: Tokens.text-primary; }

                        ScrollView {
                            height: 420px;
                            VerticalLayout {
                                spacing: 4px;
                                for item in root.history_rows : Rectangle {
                                    height: 28px;
                                    border-radius: 4px;
                                    background: Tokens.surface-panel;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        Text { text: "#" + item.index; font-size: 11px; color: Tokens.accent-bloom-hover; font-weight: 600; vertical-alignment: center; }
                                        Text { text: item.description; font-size: 12px; color: Tokens.text-secondary; vertical-alignment: center; overflow: elide; }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            Button { text: "Desfazer (Undo)"; clicked => { root.undo_clicked(); } }
                            Button { text: "Refazer (Redo)"; clicked => { root.redo_clicked(); } }
                        }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Tokens.surface-panel-raised; }

        // -------------------------------------------------------------
        // SECTION 5: CANONICAL STATUS BAR (08.2, 08.23)
        // -------------------------------------------------------------
        Rectangle {
            height: 24px;
            background: Tokens.surface-chrome-strong;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;
                alignment: center;

                // Tool Intent & Modifiers Guide
                IconDisplay { icon: IconSet.Info; size: 12px; stroke: Tokens.accent-bloom-hover; y: (parent.height - self.height) / 2; }
                Text {
                    text: root.status_hint;
                    font-size: 11px;
                    color: Tokens.text-tertiary;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                // Cursor coordinates
                Text {
                    text: root.status_coords;
                    font-size: 11px;
                    color: Tokens.accent-bloom-hover;
                    font-weight: 500;
                    vertical-alignment: center;
                }

                Rectangle { width: 1px; height: 12px; background: Tokens.border-subtle; y: 6px; }

                // Selection status
                Text {
                    text: (root.has_selection ? "1 objeto selecionado" : "Nenhum objeto selecionado") + "  |  Zoom: " + root.zoom_pct + "%  |  Snap: " + (root.snap_enabled ? "Ativo" : "Inativo");
                    font-size: 11px;
                    color: Tokens.text-disabled;
                    vertical-alignment: center;
                }
            }
        }
    }

    // -------------------------------------------------------------
    // SECTION 5: MODAL OVERLAYS (EXPORT FLOW)
    // -------------------------------------------------------------
    if root.export_dialog_open : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: Tokens.scrim;

        // Modal Card
        Rectangle {
            width: 500px;
            height: 380px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Tokens.surface-panel;
            border-radius: 8px;
            border-width: 1px;
            border-color: Tokens.border-strong;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                // Header
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Exportar Documento / Prancheta";
                        font-size: 15px;
                        font-weight: 700;
                        color: Tokens.text-primary;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 4px;
                        background: touch_close_exp.has-hover ? Tokens.overlay-pressed : transparent;
                        IconDisplay {
                            icon: IconSet.X;
                            size: 14px;
                            stroke: Tokens.text-tertiary;
                            x: 5px; y: 5px;
                        }
                        touch_close_exp := TouchArea {
                            clicked => { root.close_export_dialog_clicked(); }
                        }
                    }
                }

                Rectangle { height: 1px; background: Tokens.border-subtle; }

                // Format selection
                Text { text: "FORMATO DE EXPORTAÇÃO:"; font-size: 11px; font-weight: 700; color: Tokens.text-tertiary; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 36px;
                        horizontal-stretch: 1;
                        border-radius: 4px;
                        background: root.export_format == "png" ? Tokens.accent-bloom : Tokens.surface-control;
                        Text {
                            text: "PNG (Raster)";
                            font-size: 12px;
                            font-weight: 600;
                            color: root.export_format == "png" ? Tokens.text-primary : Tokens.text-secondary;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        TouchArea { clicked => { root.set_export_format("png"); } }
                    }
                    Rectangle {
                        height: 36px;
                        horizontal-stretch: 1;
                        border-radius: 4px;
                        background: root.export_format == "svg" ? Tokens.accent-bloom : Tokens.surface-control;
                        Text {
                            text: "SVG (Vetorial)";
                            font-size: 12px;
                            font-weight: 600;
                            color: root.export_format == "svg" ? Tokens.text-primary : Tokens.text-secondary;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        TouchArea { clicked => { root.set_export_format("svg"); } }
                    }
                    Rectangle {
                        height: 36px;
                        horizontal-stretch: 1;
                        border-radius: 4px;
                        background: root.export_format == "pdf" ? Tokens.accent-bloom : Tokens.surface-control;
                        Text {
                            text: "PDF (Krilla)";
                            font-size: 12px;
                            font-weight: 600;
                            color: root.export_format == "pdf" ? Tokens.text-primary : Tokens.text-secondary;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        TouchArea { clicked => { root.set_export_format("pdf"); } }
                    }
                }

                // Format Details box
                Rectangle {
                    height: 64px;
                    border-radius: 4px;
                    background: Tokens.surface-chrome-strong;
                    border-width: 1px;
                    border-color: Tokens.surface-control;
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 10px;
                        IconDisplay {
                            icon: IconSet.Info;
                            size: 16px;
                            stroke: Tokens.accent-bloom;
                            y: 4px;
                        }
                        Text {
                            text: root.export_format == "png" ? "Renderiza todos os objetos da prancheta para imagem raster em 72 DPI (PNG-24 com canal Alfa)." :
                                  root.export_format == "svg" ? "Gera código SVG W3C puro preservando caminhos vetoriais, estilos e geometria sem perda." :
                                  "Gera PDF vetorial multipágina com motor Krilla 0.8 de alta fidelidade com preflight.";
                            font-size: 11px;
                            color: Tokens.text-tertiary;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }

                // Status feedback
                if root.export_status_message != "" : Text {
                    text: root.export_status_message;
                    font-size: 11px;
                    font-weight: 600;
                    color: Tokens.status-success;
                    horizontal-alignment: center;
                }

                Rectangle { vertical-stretch: 1; }

                // Footer Buttons
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    Button {
                        text: "Cancelar";
                        clicked => { root.close_export_dialog_clicked(); }
                    }
                    Button {
                        text: "Salvar Arquivo com RFD...";
                        clicked => { root.do_export_clicked(); }
                    }
                }
            }
        }
    }

    // -------------------------------------------------------------
    // SECTION 6: COMMAND PALETTE OVERLAY (Ctrl+K) (08.2)
    // -------------------------------------------------------------
    if root.palette_open : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: Tokens.scrim;

        TouchArea {
            clicked => { root.close_palette(); }
        }

        Rectangle {
            width: 520px;
            height: 380px;
            x: (parent.width - self.width) / 2;
            y: 90px;
            background: Tokens.surface-panel;
            border-radius: 8px;
            border-width: 1px;
            border-color: Tokens.accent-bloom;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                LineEdit {
                    height: 32px;
                    placeholder-text: "Digite um comando… (Esc fecha)";
                    text: root.palette_query;
                    edited(t) => {
                        root.palette_query = t;
                        root.palette_query_changed(t);
                    }
                    accepted(t) => {
                        root.palette_activate_first();
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 2px;
                        for item in root.palette_items : Rectangle {
                            height: 30px;
                            border-radius: 4px;
                            background: touch_pal.has-hover ? Tokens.accent-faint : transparent;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                alignment: center;
                                Text {
                                    text: item.label;
                                    font-size: 12px;
                                    color: Tokens.text-primary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: item.hint;
                                    font-size: 10px;
                                    color: Tokens.text-disabled;
                                    vertical-alignment: center;
                                }
                            }

                            touch_pal := TouchArea {
                                clicked => { root.palette_activate(item.id); }
                            }
                        }
                    }
                }
            }
        }
    }
}
