// Petunia Design Studio — canonical UI tokens (08.35, 15.F §8).
//
// Feature code MUST reference these tokens instead of literal hex values.
// Document artwork colors are NOT UI tokens and never come from here.
//
// Values are the Petunia-owned dark reference palette; tuning requires a
// centralized change here plus visual QA (08.35).

export global Tokens {
    // ── Surfaces ────────────────────────────────────────────────────────────
    out property <color> surface-workspace: #202124;
    out property <color> surface-chrome: #27282B;
    out property <color> surface-chrome-strong: #222326;
    out property <color> surface-panel: #303236;
    out property <color> surface-panel-raised: #373A3F;
    out property <color> surface-control: #3A3D42;
    out property <color> surface-control-hover: #464A50;
    out property <color> surface-control-pressed: #50545B;

    // ── Borders ─────────────────────────────────────────────────────────────
    out property <color> border-subtle: #41444A;
    out property <color> border-strong: #555A63;

    // ── Text ────────────────────────────────────────────────────────────────
    out property <color> text-primary: #F2F3F5;
    out property <color> text-secondary: #C2C6CC;
    out property <color> text-tertiary: #8E949D;
    out property <color> text-disabled: #666C75;

    // ── Accent (Bloom) ──────────────────────────────────────────────────────
    out property <color> accent-bloom: #B77AFF;
    out property <color> accent-bloom-hover: #C48FFF;
    out property <color> accent-bloom-pressed: #9F5FEA;
    out property <color> accent-selection-soft: #B77AFF33;
    out property <color> accent-faint: #B77AFF22;

    // ── Overlays / scrim ────────────────────────────────────────────────────
    out property <color> overlay-hover: #FFFFFF14;
    out property <color> overlay-pressed: #FFFFFF24;
    out property <color> scrim: #000000BB;

    // ── Persona identity ────────────────────────────────────────────────────
    out property <color> studio-design: #35C7D4;
    out property <color> studio-photo: #F06C8D;

    // ── Status ──────────────────────────────────────────────────────────────
    out property <color> status-success: #55C58A;
    out property <color> status-warning: #E3AE52;
    out property <color> status-error: #E76573;

    // ── Geometry (logical px, 4 px grid) ────────────────────────────────────
    out property <length> menu-row-height: 28px;
    out property <length> persona-row-height: 40px;
    out property <length> context-toolbar-height: 34px;
    out property <length> tab-strip-height: 30px;
    out property <length> status-bar-height: 26px;
    out property <length> tool-rail-width: 44px;
    out property <length> tool-rail-padding: 5px;
    out property <length> tool-button-size: 34px;
    out property <length> tool-button-gap: 2px;
    out property <length> right-dock-default-width: 304px;
    out property <length> right-dock-min-width: 240px;
    out property <length> right-dock-max-width: 520px;
    out property <length> panel-tab-height: 32px;
    out property <length> panel-padding: 8px;
    out property <length> panel-section-header: 28px;
    out property <length> property-row-height: 30px;
    out property <length> layer-row-height: 28px;
    out property <length> splitter-visual: 1px;
    out property <length> splitter-hit: 6px;
    out property <length> status-item-height: 22px;

    // ── Radii ───────────────────────────────────────────────────────────────
    out property <length> radius-micro: 3px;
    out property <length> radius-control: 5px;
    out property <length> radius-popover: 7px;
    out property <length> radius-dialog: 10px;

    // ── Spacing scale ───────────────────────────────────────────────────────
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 20px;
    out property <length> space-6: 24px;
    out property <length> space-8: 32px;
    out property <length> space-10: 40px;

    // ── Typography ──────────────────────────────────────────────────────────
    out property <length> caption-size: 11px;
    out property <length> small-size: 12px;
    out property <length> body-size: 13px;
    out property <length> panel-title-size: 13px;
    out property <length> dialog-section-size: 15px;
    out property <length> dialog-title-size: 18px;

    // ── Focus ───────────────────────────────────────────────────────────────
    out property <length> focus-ring: 2px;
    out property <length> focus-ring-offset: 1px;
}
