import { Button, CheckBox, Slider, ScrollView } from "std-widgets.slint";
import { IconDisplay, IconSet, Icon } from "@lucide";
import { Badge, BadgeVariant } from "slintcn/components/badge.slint";
import { Tokens } from "slintcn/theme/tokens.slint";

export struct LayerRowItem {
    name: string,
    visible: bool,
    locked: bool,
    selected: bool,
}

export struct HistoryRowItem {
    index: int,
    description: string,
}

export struct CanvasObjectItem {
    id: string,
    name: string,
    x: length,
    y: length,
    w: length,
    h: length,
    bg_color: color,
    selected: bool,
    is_circle: bool,
}

component ToolButton inherits Rectangle {
    in property <Icon> icon;
    in property <bool> active: false;
    callback clicked;

    width: 40px;
    height: 40px;
    border-radius: 6px;
    background: active ? #3b82f633 : (touch.has-hover ? #ffffff15 : transparent);
    border-width: active ? 1px : 0px;
    border-color: #3b82f6;

    IconDisplay {
        icon: root.icon;
        size: 20px;
        stroke: root.active ? #60a5fa : (touch.has-hover ? #f4f4f5 : #a1a1aa);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "Aubrieta Design Studio — Slint";
    preferred-width: 1280px;
    preferred-height: 800px;
    background: #18181b;

    in-out property <string> active_tool_name: "Select";
    in-out property <int> zoom_pct: 100;
    in-out property <bool> snap_enabled: true;
    in-out property <string> status_coords: "Doc: X: 0.0 pt  Y: 0.0 pt";
    in-out property <int> active_tab_index: 0; // 0: Layers, 1: Props, 2: History, 3: Merge

    // Inspector Properties
    in-out property <bool> has_selection: true;
    in-out property <string> selected_name: "Hero Card";
    in-out property <string> selected_bounds: "X: 60.0 pt   Y: 60.0 pt   W: 300.0 pt   H: 180.0 pt";
    in-out property <string> selected_fill: "aubrieta.blue/500";
    in-out property <float> selected_opacity: 100.0;
    in-out property <length> prop_x: 100px;
    in-out property <length> prop_y: 100px;
    in-out property <length> prop_w: 300px;
    in-out property <length> prop_h: 180px;

    // Data merge
    in-out property <string> merge_source: "showcase_data.csv";
    in-out property <int> merge_records: 120;
    in-out property <int> merge_bindings: 4;

    // Layers & History models
    in-out property <[LayerRowItem]> layer_rows: [
        { name: "Hero Card", visible: true, locked: false, selected: true },
        { name: "Accent Circle", visible: true, locked: false, selected: false },
    ];
    in-out property <[HistoryRowItem]> history_rows: [
        { index: 1, description: "Create Main Artboard" },
        { index: 2, description: "Create Hero Card" },
        { index: 3, description: "Create Accent Circle" },
    ];

    // Canvas geometry
    in-out property <length> artboard_x: 60px;
    in-out property <length> artboard_y: 60px;
    in-out property <length> artboard_w: 800px;
    in-out property <length> artboard_h: 600px;
    in-out property <length> bleed_margin: 10px;
    in-out property <length> margin_inset: 36px;
    in-out property <length> guide_x: 200px;

    // Canvas dynamic objects and interactive preview
    in-out property <[CanvasObjectItem]> canvas_objects: [
        { id: "1", name: "Hero Card", x: 60px, y: 60px, w: 300px, h: 180px, bg_color: #3b82f6, selected: true, is_circle: false },
        { id: "2", name: "Accent Circle", x: 400px, y: 120px, w: 140px, h: 140px, bg_color: #eab308, selected: false, is_circle: true },
    ];
    in-out property <bool> has_preview: false;
    in-out property <length> preview_x: 0px;
    in-out property <length> preview_y: 0px;
    in-out property <length> preview_w: 0px;
    in-out property <length> preview_h: 0px;

    callback select_tool(string);
    callback undo_clicked();
    callback redo_clicked();
    callback zoom_in_clicked();
    callback zoom_out_clicked();
    callback fit_canvas_clicked();
    callback new_doc_clicked();
    callback open_doc_clicked();
    callback save_doc_clicked();
    callback place_image_clicked();
    callback snap_toggled(bool);
    callback tab_changed(int);
    callback canvas_dragged(length, length);
    callback canvas_pointer_down(length, length);
    callback canvas_pointer_up(length, length);
    callback select_layer_by_index(int);
    callback delete_selected_clicked();
    callback add_rectangle_clicked();
    callback add_circle_clicked();
    callback set_selected_color(color);
    callback adjust_prop_x(length);
    callback adjust_prop_y(length);
    callback adjust_prop_w(length);
    callback adjust_prop_h(length);
    callback set_opacity_value(float);
    callback duplicate_selected_clicked();
    callback toggle_layer_visibility(int);
    callback toggle_layer_lock(int);
    callback reorder_layer_up(int);
    callback reorder_layer_down(int);

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // 1. Top Panel: Header & Context Toolbar
        Rectangle {
            height: 70px;
            background: #27272a;
            border-width: 1px;
            border-color: #3f3f46;

            VerticalLayout {
                padding: 6px;
                spacing: 4px;

                // Menu row
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Text {
                        text: "🎨 Aubrieta Studio";
                        color: #60a5fa;
                        font-weight: 700;
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    Badge {
                        text: "Slint UI";
                        variant: BadgeVariant.outline;
                    }

                    Button {
                        text: "Novo";
                        clicked => { root.new_doc_clicked(); }
                    }

                    Button {
                        text: "Abrir...";
                        clicked => { root.open_doc_clicked(); }
                    }

                    Button {
                        text: "Salvar...";
                        clicked => { root.save_doc_clicked(); }
                    }

                    Button {
                        text: "Inserir Imagem...";
                        clicked => { root.place_image_clicked(); }
                    }

                    Button {
                        text: "Ajustar Tela";
                        clicked => { root.fit_canvas_clicked(); }
                    }

                    Button {
                        text: "+ Retângulo";
                        clicked => { root.add_rectangle_clicked(); }
                    }

                    Button {
                        text: "+ Elipse";
                        clicked => { root.add_circle_clicked(); }
                    }

                    Button {
                        text: "🗑 Deletar";
                        clicked => { root.delete_selected_clicked(); }
                    }
                }

                // Context bar
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Text {
                        text: "Ferramenta: " + root.active_tool_name;
                        color: #93c5fd;
                        font-weight: 600;
                        font-size: 13px;
                        vertical-alignment: center;
                    }

                    Button {
                        text: "Undo (Ctrl+Z)";
                        clicked => { root.undo_clicked(); }
                    }

                    Button {
                        text: "Redo (Ctrl+Y)";
                        clicked => { root.redo_clicked(); }
                    }

                    Text {
                        text: "Zoom: " + root.zoom_pct + "%";
                        color: #e4e4e7;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    Button {
                        text: "+";
                        width: 32px;
                        clicked => { root.zoom_in_clicked(); }
                    }

                    Button {
                        text: "-";
                        width: 32px;
                        clicked => { root.zoom_out_clicked(); }
                    }

                    CheckBox {
                        text: "Magnetic Snap";
                        checked: root.snap_enabled;
                        toggled => { root.snap_toggled(self.checked); }
                    }
                }
            }
        }

        // 2. Middle Row: Tool Rail + Central Canvas + Right Dock Inspector
        HorizontalLayout {
            spacing: 0px;

            // Left Tool Rail
            Rectangle {
                width: 52px;
                background: #202023;
                border-width: 1px;
                border-color: #3f3f46;

                VerticalLayout {
                    padding: 5px;
                    spacing: 6px;
                    alignment: start;

                    ToolButton {
                        icon: IconSet.MousePointer2;
                        active: root.active_tool_name == "Select";
                        clicked => { root.select_tool("Select"); }
                    }
                    ToolButton {
                        icon: IconSet.Pointer;
                        active: root.active_tool_name == "Node";
                        clicked => { root.select_tool("Node"); }
                    }
                    ToolButton {
                        icon: IconSet.Square;
                        active: root.active_tool_name == "Rectangle";
                        clicked => { root.select_tool("Rectangle"); }
                    }
                    ToolButton {
                        icon: IconSet.Circle;
                        active: root.active_tool_name == "Ellipse";
                        clicked => { root.select_tool("Ellipse"); }
                    }
                    ToolButton {
                        icon: IconSet.Trash2;
                        active: false;
                        clicked => { root.delete_selected_clicked(); }
                    }
                }
            }

            // Central Canvas
            canvas_area := Rectangle {
                horizontal-stretch: 1;
                background: #141416;
                clip: true;

                // Artboard Shadow
                Rectangle {
                    x: root.artboard_x + 4px;
                    y: root.artboard_y + 4px;
                    width: root.artboard_w;
                    height: root.artboard_h;
                    background: #00000055;
                    border-radius: 2px;
                }

                // Bleed Guideline (Magenta)
                Rectangle {
                    x: root.artboard_x - root.bleed_margin;
                    y: root.artboard_y - root.bleed_margin;
                    width: root.artboard_w + (root.bleed_margin * 2);
                    height: root.artboard_h + (root.bleed_margin * 2);
                    border-width: 1px;
                    border-color: #f43f5e;
                }

                // Artboard Paper White
                artboard := Rectangle {
                    x: root.artboard_x;
                    y: root.artboard_y;
                    width: root.artboard_w;
                    height: root.artboard_h;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #cbd5e1;

                    // Header text
                    Text {
                        x: 8px;
                        y: -18px;
                        text: "📄 Main Artboard (800x600 pt) • Clique ou arraste para desenhar / mover";
                        color: #94a3b8;
                        font-size: 12px;
                    }

                    // Margin Guideline (Cyan)
                    Rectangle {
                        x: root.margin_inset;
                        y: root.margin_inset;
                        width: parent.width - (root.margin_inset * 2);
                        height: parent.height - (root.margin_inset * 2);
                        border-width: 1px;
                        border-color: #38bdf8;
                    }

                    // Vertical Guide line
                    Rectangle {
                        x: root.guide_x;
                        y: 0px;
                        width: 1px;
                        height: parent.height;
                        background: #06b6d4;
                    }

                    // Dynamic objects list
                    for obj in root.canvas_objects : Rectangle {
                        x: obj.x;
                        y: obj.y;
                        width: obj.w;
                        height: obj.h;
                        background: obj.bg_color;
                        border-radius: obj.is_circle ? (obj.w / 2) : 4px;
                        border-width: obj.selected ? 2.5px : 1px;
                        border-color: obj.selected ? #60a5fa : #ffffff88;

                        // Selection indicator & 8 resize handles
                        if obj.selected : Rectangle {
                            x: -3px;
                            y: -3px;
                            width: parent.width + 6px;
                            height: parent.height + 6px;
                            border-width: 1.5px;
                            border-color: #3b82f6;
                            border-radius: obj.is_circle ? (parent.width + 6px) / 2 : 2px;

                            // 4 corner handles
                            Rectangle { x: -4px; y: -4px; width: 8px; height: 8px; background: #ffffff; border-width: 1.5px; border-color: #2563eb; border-radius: 1px; }
                            Rectangle { x: parent.width - 4px; y: -4px; width: 8px; height: 8px; background: #ffffff; border-width: 1.5px; border-color: #2563eb; border-radius: 1px; }
                            Rectangle { x: -4px; y: parent.height - 4px; width: 8px; height: 8px; background: #ffffff; border-width: 1.5px; border-color: #2563eb; border-radius: 1px; }
                            Rectangle { x: parent.width - 4px; y: parent.height - 4px; width: 8px; height: 8px; background: #ffffff; border-width: 1.5px; border-color: #2563eb; border-radius: 1px; }

                            // 4 edge midpoint handles
                            Rectangle { x: (parent.width - 8px) / 2; y: -4px; width: 8px; height: 8px; background: #ffffff; border-width: 1.5px; border-color: #2563eb; border-radius: 1px; }
                            Rectangle { x: (parent.width - 8px) / 2; y: parent.height - 4px; width: 8px; height: 8px; background: #ffffff; border-width: 1.5px; border-color: #2563eb; border-radius: 1px; }
                            Rectangle { x: -4px; y: (parent.height - 8px) / 2; width: 8px; height: 8px; background: #ffffff; border-width: 1.5px; border-color: #2563eb; border-radius: 1px; }
                            Rectangle { x: parent.width - 4px; y: (parent.height - 8px) / 2; width: 8px; height: 8px; background: #ffffff; border-width: 1.5px; border-color: #2563eb; border-radius: 1px; }
                        }

                        Text {
                            text: obj.name;
                            color: #ffffff;
                            font-weight: 600;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Active drawing preview box
                    if root.has_preview : Rectangle {
                        x: root.preview_x;
                        y: root.preview_y;
                        width: root.preview_w;
                        height: root.preview_h;
                        background: #3b82f633;
                        border-width: 1.5px;
                        border-color: #3b82f6;
                        border-radius: 3px;
                    }
                }

                // Interactive TouchArea on top of canvas capturing all mouse events
                TouchArea {
                    width: parent.width;
                    height: parent.height;

                    pointer-event(evt) => {
                        if (evt.kind == PointerEventKind.down) {
                            root.canvas_pointer_down(self.mouse-x, self.mouse-y);
                        } else if (evt.kind == PointerEventKind.up) {
                            root.canvas_pointer_up(self.mouse-x, self.mouse-y);
                        }
                    }

                    moved => {
                        if (self.pressed) {
                            root.canvas_dragged(self.mouse-x, self.mouse-y);
                        }
                    }
                }
            }

            // Right Dock Inspector
            Rectangle {
                width: 290px;
                background: #202023;
                border-width: 1px;
                border-color: #3f3f46;

                VerticalLayout {
                    padding: 8px;
                    spacing: 8px;

                    // Tab selector
                    HorizontalLayout {
                        spacing: 4px;
                        Button {
                            text: "Layers";
                            clicked => { root.tab_changed(0); }
                        }
                        Button {
                            text: "Props";
                            clicked => { root.tab_changed(1); }
                        }
                        Button {
                            text: "History";
                            clicked => { root.tab_changed(2); }
                        }
                        Button {
                            text: "Merge";
                            clicked => { root.tab_changed(3); }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #3f3f46;
                    }

                    // Tab 0: Layers
                    if root.active_tab_index == 0 : VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Object Hierarchy";
                            font-weight: 700;
                            color: #60a5fa;
                            font-size: 14px;
                        }
                        Text {
                            text: "📄 Main Artboard";
                            color: #93c5fd;
                            font-size: 12px;
                        }
                        for item[idx] in root.layer_rows : Rectangle {
                            height: 32px;
                            background: item.selected ? #2563eb33 : #27272a;
                            border-radius: 4px;
                            border-width: item.selected ? 1px : 0px;
                            border-color: #3b82f6;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 6px;

                                // Selection indicator
                                TouchArea {
                                    width: 18px;
                                    clicked => { root.select_layer_by_index(idx); }
                                    Text {
                                        text: item.selected ? "●" : "○";
                                        color: item.selected ? #60a5fa : #71717a;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                    }
                                }

                                // Visibility toggle
                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    border-radius: 3px;
                                    background: touch_vis.has-hover ? #3f3f46 : transparent;
                                    touch_vis := TouchArea {
                                        clicked => { root.toggle_layer_visibility(idx); }
                                    }
                                    Text {
                                        text: item.visible ? "👁" : "🕶";
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Lock toggle
                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    border-radius: 3px;
                                    background: touch_lock.has-hover ? #3f3f46 : transparent;
                                    touch_lock := TouchArea {
                                        clicked => { root.toggle_layer_lock(idx); }
                                    }
                                    Text {
                                        text: item.locked ? "🔒" : "🔓";
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Layer name (clickable to select)
                                TouchArea {
                                    horizontal-stretch: 1;
                                    clicked => { root.select_layer_by_index(idx); }
                                    Text {
                                        text: item.name;
                                        color: item.selected ? #ffffff : #d4d4d8;
                                        font-size: 13px;
                                        font-weight: item.selected ? 600 : 400;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                // Reorder buttons
                                Rectangle {
                                    width: 18px;
                                    height: 20px;
                                    border-radius: 3px;
                                    background: touch_up.has-hover ? #3f3f46 : transparent;
                                    touch_up := TouchArea {
                                        clicked => { root.reorder_layer_up(idx); }
                                    }
                                    Text {
                                        text: "▲";
                                        font-size: 10px;
                                        color: #a1a1aa;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    width: 18px;
                                    height: 20px;
                                    border-radius: 3px;
                                    background: touch_dn.has-hover ? #3f3f46 : transparent;
                                    touch_dn := TouchArea {
                                        clicked => { root.reorder_layer_down(idx); }
                                    }
                                    Text {
                                        text: "▼";
                                        font-size: 10px;
                                        color: #a1a1aa;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Tab 1: Properties
                    if root.active_tab_index == 1 : VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: "Properties Inspector";
                            font-weight: 700;
                            color: #60a5fa;
                            font-size: 14px;
                        }

                        if !root.has_selection : VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "(Nenhum objeto selecionado)";
                                color: #71717a;
                                font-italic: true;
                                font-size: 12px;
                            }
                            Text {
                                text: "Clique em um objeto no canvas ou nas camadas para inspecionar e editar suas propriedades.";
                                color: #a1a1aa;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }

                        if root.has_selection : VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: root.selected_name;
                                    color: #f4f4f5;
                                    font-size: 14px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Badge {
                                    text: "Vetorial";
                                    variant: BadgeVariant.secondary;
                                }
                            }

                            Rectangle { height: 1px; background: #3f3f46; }

                            Text {
                                text: "Geometria & Posição:";
                                color: #93c5fd;
                                font-size: 12px;
                                font-weight: 600;
                            }

                            // Coordinate adjusters (X, Y)
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "X: " + round(root.prop_x / 1px) + " px"; color: #d4d4d8; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                                Button { text: "-10"; height: 26px; clicked => { root.adjust_prop_x(-10px); } }
                                Button { text: "+10"; height: 26px; clicked => { root.adjust_prop_x(10px); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Y: " + round(root.prop_y / 1px) + " px"; color: #d4d4d8; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                                Button { text: "-10"; height: 26px; clicked => { root.adjust_prop_y(-10px); } }
                                Button { text: "+10"; height: 26px; clicked => { root.adjust_prop_y(10px); } }
                            }

                            // Dimension adjusters (W, H)
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "W: " + round(root.prop_w / 1px) + " px"; color: #d4d4d8; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                                Button { text: "-10"; height: 26px; clicked => { root.adjust_prop_w(-10px); } }
                                Button { text: "+10"; height: 26px; clicked => { root.adjust_prop_w(10px); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "H: " + round(root.prop_h / 1px) + " px"; color: #d4d4d8; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                                Button { text: "-10"; height: 26px; clicked => { root.adjust_prop_h(-10px); } }
                                Button { text: "+10"; height: 26px; clicked => { root.adjust_prop_h(10px); } }
                            }

                            Rectangle { height: 1px; background: #3f3f46; }

                            // Opacity
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "Opacidade:"; color: #93c5fd; font-size: 12px; font-weight: 600; }
                                Text { text: round(root.selected_opacity) + "%"; color: #f4f4f5; font-size: 12px; }
                            }
                            Slider {
                                value: root.selected_opacity;
                                minimum: 0.0;
                                maximum: 100.0;
                                changed(val) => { root.set_opacity_value(val); }
                            }

                            Rectangle { height: 1px; background: #3f3f46; }

                            Text {
                                text: "Preenchimento Rápido:";
                                color: #93c5fd;
                                font-size: 12px;
                                font-weight: 600;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    width: 30px; height: 30px; border-radius: 4px; background: #3b82f6; border-width: 1px; border-color: #ffffff44;
                                    TouchArea { clicked => { root.set_selected_color(#3b82f6); } }
                                }
                                Rectangle {
                                    width: 30px; height: 30px; border-radius: 4px; background: #10b981; border-width: 1px; border-color: #ffffff44;
                                    TouchArea { clicked => { root.set_selected_color(#10b981); } }
                                }
                                Rectangle {
                                    width: 30px; height: 30px; border-radius: 4px; background: #eab308; border-width: 1px; border-color: #ffffff44;
                                    TouchArea { clicked => { root.set_selected_color(#eab308); } }
                                }
                                Rectangle {
                                    width: 30px; height: 30px; border-radius: 4px; background: #8b5cf6; border-width: 1px; border-color: #ffffff44;
                                    TouchArea { clicked => { root.set_selected_color(#8b5cf6); } }
                                }
                                Rectangle {
                                    width: 30px; height: 30px; border-radius: 4px; background: #f43f5e; border-width: 1px; border-color: #ffffff44;
                                    TouchArea { clicked => { root.set_selected_color(#f43f5e); } }
                                }
                            }

                            Button {
                                text: "📋 Duplicar Objeto";
                                clicked => { root.duplicate_selected_clicked(); }
                            }

                            Button {
                                text: "🗑 Excluir Objeto";
                                clicked => { root.delete_selected_clicked(); }
                            }
                        }
                    }

                    // Tab 2: History
                    if root.active_tab_index == 2 : VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Transaction History";
                            font-weight: 700;
                            color: #60a5fa;
                            font-size: 14px;
                        }
                        for item in root.history_rows : Rectangle {
                            height: 24px;
                            background: #27272a;
                            border-radius: 3px;
                            HorizontalLayout {
                                padding-left: 6px;
                                spacing: 6px;
                                Text {
                                    text: "[" + item.index + "] " + item.description;
                                    color: #e4e4e7;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Tab 3: Data Merge
                    if root.active_tab_index == 3 : VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Variable Data Merge";
                            font-weight: 700;
                            color: #60a5fa;
                            font-size: 14px;
                        }
                        Text {
                            text: "Source: " + root.merge_source;
                            color: #e4e4e7;
                            font-size: 13px;
                        }
                        Text {
                            text: "Records: " + root.merge_records + " | Bindings: " + root.merge_bindings;
                            color: #a1a1aa;
                            font-size: 12px;
                        }
                        Text {
                            text: "Status: Ready to Merge";
                            color: #22c55e;
                            font-weight: 600;
                            font-size: 13px;
                        }
                    }
                }
            }
        }

        // 3. Bottom Status Bar
        Rectangle {
            height: 28px;
            background: #18181b;
            border-width: 1px;
            border-color: #27272a;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 16px;

                Text {
                    text: root.status_coords;
                    color: #71717a;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                Text {
                    text: "Ativa: " + root.active_tool_name;
                    color: #60a5fa;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                Text {
                    text: "Aubrieta Shell [Slint] • One-Tree Document Engine • Nondestructive";
                    color: #52525b;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
    }
}
