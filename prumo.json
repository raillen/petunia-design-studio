{
  "version": 3,
  "protocol": {
    "compatible": ">=3 <4",
    "version": 3
  },
  "framework": {
    "name": "prumo",
    "version": "0.6.0"
  },
  "project": {
    "name": "Aubrieta Design",
    "description": "Next-generation professional vector and raster creative suite built with Rust.",
    "type": [
      "desktop-gui",
      "vector-editor",
      "raster-editor",
      "creative-suite"
    ]
  },
  "ai": {
    "autonomy": "agentic",
    "orchestrator": "native",
    "preferred_models": [
      {
        "id": "gemini-3.8-flash",
        "provider": "google"
      }
    ]
  },
  "documentation": {
    "audiences": [
      "user",
      "developer",
      "operations",
      "agent"
    ],
    "canonical_format": "markdown",
    "entrypoint": "docs/PRUMO.md",
    "source_locale": "en",
    "site": {
      "enabled": true,
      "generated": true,
      "public_internal_views": true,
      "source": "docs"
    },
    "virtual_chunking": true
  },
  "context": {
    "architecture": "progressive-context-architecture",
    "budget_profile": "medium",
    "deep_recursion": {
      "enabled": false,
      "experimental": true
    },
    "methodology": "lean-progressive-context",
    "mode": "progressive",
    "profiles": {
      "large": {
        "context_hard_tokens": 32000,
        "context_target_tokens": 16000,
        "max_delegation_depth": 1,
        "max_expansion_rounds": 3,
        "output_hard_tokens": 6000,
        "output_target_tokens": 3000
      },
      "medium": {
        "context_hard_tokens": 16000,
        "context_target_tokens": 8000,
        "max_delegation_depth": 1,
        "max_expansion_rounds": 2,
        "output_hard_tokens": 3000,
        "output_target_tokens": 1500
      },
      "small": {
        "context_hard_tokens": 6000,
        "context_target_tokens": 3000,
        "max_delegation_depth": 0,
        "max_expansion_rounds": 1,
        "output_hard_tokens": 1000,
        "output_target_tokens": 500
      }
    },
    "runtime": {
      "completed_context_ttl": "0d",
      "database": ".prumo/runtime/prumo.db",
      "failed_context_ttl": "7d"
    }
  },
  "features": [
    "vector-engine",
    "raster-engine",
    "typography",
    "color-management",
    "evaluation",
    "rendering",
    "io",
    "plugins",
    "mcp",
    "documentation"
  ],
  "goals": {
    "active_goal": "P03-G01",
    "active_phase": "P03"
  },
  "intelligence": {
    "distinguish_observed_estimated": true,
    "enabled": true,
    "path": ".prumo/history/project-intelligence.json",
    "task_reports": true,
    "track_cost": true,
    "track_input_tokens": true,
    "track_output_tokens": true
  },
  "orchestration": {
    "autonomy": "agentic",
    "orchestrator": "native",
    "protocol": "POP"
  },
  "quality": {
    "accessibility": true,
    "performance": "high",
    "security": "high"
  },
  "risk": [
    "performance-critical",
    "security"
  ],
  "stack": {
    "languages": [
      "rust"
    ],
    "runtime": [
      "wgpu",
      "vello"
    ],
    "tooling": [
      "cargo",
      "clippy",
      "rustfmt",
      "xtask"
    ]
  }
}
